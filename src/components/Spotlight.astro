---
import type { SpotlightItem } from "@/types";

interface Props {
  items: SpotlightItem[];
}

const { items } = Astro.props;
---

<div class="spotlights">
  {
    items.map((item) => (
      <article class="spot">
        <button
          type="button"
          class="shot"
          data-zoom
          aria-haspopup="dialog"
          aria-label={`Ampliar captura: ${item.imageAlt}`}
        >
          <img
            src={item.image}
            alt={item.imageAlt}
            loading="lazy"
            decoding="async"
          />
        </button>
        <dialog class="viewer" aria-label={`Captura ampliada: ${item.imageAlt}`}>
          <img src={item.image} alt={item.imageAlt} loading="lazy" decoding="async" />
          <form method="dialog">
            <button type="submit" class="button">Cerrar</button>
          </form>
        </dialog>
        <div class="body">
          <div class="head">
            <h3>{item.name}</h3>
            <span class="mono badge">Recomendado</span>
          </div>
          <p>{item.description}</p>
          <footer class="foot">
            {item.links.map((link) => (
              <a class="button" href={link.href} target="_blank" rel="noopener">
                {link.label}
              </a>
            ))}
          </footer>
        </div>
      </article>
    ))
  }
</div>

<style>
  .spotlights {
    display: grid;
    gap: var(--space-lg);
    margin: var(--space-lg) 0 0;
  }

  .spot {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
    background: var(--canvas-card);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    padding: var(--space-lg);
  }

  .shot {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius);
    border: 1px solid var(--hairline);
    background: var(--canvas-soft);
    padding: 0;
    font: inherit;
    cursor: zoom-in;

    img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      display: block;
    }
  }

  .viewer {
    max-width: min(1200px, 92vw);
    background: var(--canvas-card);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    padding: var(--space-lg);
    color: var(--body);

    &::backdrop {
      background: rgb(0 0 0 / 0.8);
    }

    img {
      width: 100%;
      height: auto;
      display: block;
      border-radius: var(--radius);
    }

    form {
      display: flex;
      justify-content: flex-end;
      margin-top: var(--space-lg);
    }
  }

  .viewer .button {
    cursor: pointer;
  }

  .viewer[open] {
    animation: viewer-in 160ms ease-out;
  }

  .viewer[open]::backdrop {
    animation: backdrop-in 160ms ease-out;
  }

  @keyframes viewer-in {
    from {
      opacity: 0;
      transform: scale(0.97) translateY(8px);
    }
  }

  @keyframes backdrop-in {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .viewer[open],
    .viewer[open]::backdrop {
      animation: none;
    }
  }

  .body {
    display: flex;
    flex-direction: column;

    p {
      margin: 0 0 var(--space-md);
    }
  }

  .head {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-md);
    margin: 0 0 var(--space-sm);

    h3 {
      margin: 0;
    }
  }

  .badge {
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    border: 1px solid var(--accent);
    border-radius: var(--radius-pill);
    padding: var(--space-xs) var(--space-md);
    white-space: nowrap;
    margin-left: auto;
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-md);
    margin-top: auto;
    padding-top: var(--space-md);
  }

  @media (min-width: 768px) {
    .spot {
      grid-template-columns: 3fr 2fr;
      align-items: center;
    }
  }
</style>

<script>
  for (const card of document.querySelectorAll(".spot")) {
    const trigger = card.querySelector("button[data-zoom]");
    const viewer = card.querySelector("dialog");
    trigger?.addEventListener("click", () => viewer?.showModal());
    viewer?.addEventListener("click", (event) => {
      if (event.target === viewer) viewer.close();
    });
  }
</script>
