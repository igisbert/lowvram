---
import { navigation } from "@/data/navigation";

const current = Astro.url.pathname.replace(/\/$/, "") || "/";
function isActive(href: string): boolean {
  const clean = href.replace(/\/$/, "") || "/";
  return clean === current;
}
---

<a class="skip-link" href="#main">Saltar al contenido</a>
<header class="site-header">
  <div class="container bar">
    <a class="brand mono" href="/" aria-label="Inicio">lowvram</a>
    <button
      class="menu-button"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
    >
      Menú
    </button>
    <nav id="site-nav" class="site-nav" aria-label="Navegación principal">
      <ul>
        {navigation.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? "page" : undefined}
              class:list={[{ active: isActive(item.href) }]}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  const button = document.querySelector(".menu-button");
  const nav = document.getElementById("site-nav");
  button?.addEventListener("click", () => {
    const open = nav?.classList.toggle("open") ?? false;
    button.setAttribute("aria-expanded", String(open));
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && nav?.classList.contains("open")) {
      nav.classList.remove("open");
      button?.setAttribute("aria-expanded", "false");
      (button as HTMLButtonElement | null)?.focus();
    }
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--canvas);
    border-bottom: 1px solid var(--hairline);
  }

  .bar {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    padding-block: var(--space-md);
  }

  .brand {
    color: var(--ink);
    text-decoration: none;
    font-size: 0.875rem;
    letter-spacing: 0.08em;
    margin-right: auto;
  }

  .menu-button {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    background: transparent;
    color: var(--ink);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-pill);
    padding: var(--space-xs) var(--space-md);
    font: inherit;
    font-size: 0.875rem;
    cursor: pointer;

    &[aria-expanded="true"] {
      border-color: var(--accent);
      background: rgb(255 209 220 / 0.08);
      color: var(--accent);
    }
  }

  .site-nav {
    display: none;

    &.open {
      display: block;
      position: absolute;
      top: calc(100% + var(--space-sm));
      right: var(--space-xl);
      min-width: 220px;
      background: var(--canvas-card);
      border: 1px solid var(--hairline);
      border-radius: var(--radius);
      padding: var(--space-md) var(--space-lg);
    }

    ul {
      display: flex;
      flex-direction: column;
      gap: var(--space-sm);
      list-style: none;
      margin: 0;
      padding: 0;
    }

    a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      color: var(--body);
      text-decoration: none;
      font-size: 0.875rem;
      border-bottom: 2px solid transparent;

      &.active {
        color: var(--ink);
        border-bottom-color: var(--accent);
      }
    }
  }

  @media (min-width: 768px) {
    .menu-button {
      display: none;
    }

    .site-nav {
      display: block;
      position: static;

      ul {
        flex-direction: row;
        gap: var(--space-xl);
      }
    }
  }
</style>
