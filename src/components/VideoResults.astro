---
import InferenceTime from "@/components/InferenceTime.astro";
import type { VideoResult } from "@/types";

interface Props {
  items: VideoResult[];
}

const { items } = Astro.props;
---

{
  items.length === 0 ? (
    <div class="empty" role="status">
      <p class="mono">Sin resultados todavía</p>
      <p>
        TODO: sustituir por datos reales. Cuando generes tus vídeos, añade una
        entrada al array y aparecerá aquí.
      </p>
    </div>
  ) : (
    <div class="videos">
      {items.map((item) => (
        <article class="card">
          <div class="frame">
            <video
              src={item.src}
              controls
              preload="metadata"
              aria-label={item.label}
            >
              Tu navegador no soporta vídeo HTML5.
            </video>
            <span class="mono badge">{item.model}</span>
          </div>
          {item.prompt ? <p class="mono prompt">{item.prompt}</p> : null}
        </article>
      ))}
    </div>
  )
}

<style>
  .videos {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
  }

  @media (min-width: 768px) {
    .videos {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .card {
    background: var(--canvas-card);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    padding: var(--space-xl);
  }

  .frame {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius);
    border: 1px solid var(--hairline);
    background: var(--canvas-soft);

    video {
      width: 100%;
      height: 100%;
      display: block;
    }
  }

  .badge {
    position: absolute;
    top: var(--space-md);
    left: var(--space-md);
    background: rgb(10 10 10 / 0.8);
    color: var(--ink);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: var(--space-xs) var(--space-md);
    border-radius: var(--radius-pill);
    border: 1px solid var(--hairline);
  }

  .prompt {
    font-size: 0.8125rem;
    color: var(--ink);
    margin: var(--space-sm) 0 0;
    border-top: 1px solid var(--hairline);
    padding-top: var(--space-md);
    overflow-wrap: anywhere;
  }

  .empty {
    background: var(--canvas-soft);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    padding: var(--space-3xl);
    text-align: center;

    p:first-child {
      color: var(--ink);
      text-transform: uppercase;
      font-size: 0.75rem;
      letter-spacing: 0.08em;
    }

    p:last-child {
      color: var(--mute);
      font-size: 0.875rem;
      margin-inline: auto;
    }
  }
</style>
