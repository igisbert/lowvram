---
import { Minus, Plus } from "@lucide/astro";
import type { SoftwareItem } from "@/types";

interface Props {
  item: SoftwareItem;
}

const { item } = Astro.props;
---

<article class="card">
  <div class="head">
    <h3>{item.name}</h3>
    {item.recommended && <span class="mono badge">Recomendado</span>}
  </div>
  <p>{item.description}</p>
  <p class="audience"><span class="mono kicker">Para quién</span> · {item.audience}</p>
  {item.pros && (
    <ul class="points">
      {item.pros.map((pro) => (
        <li class="pro"><Plus size={14} /><span>{pro}</span></li>
      ))}
    </ul>
  )}
  {item.cons && (
    <ul class="points">
      {item.cons.map((con) => (
        <li class="con"><Minus size={14} /><span>{con}</span></li>
      ))}
    </ul>
  )}
  <footer class="foot">
    {item.links.map((link) => (
      <a class="button" href={link.href} target="_blank" rel="noopener">{link.label}</a>
    ))}
  </footer>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--canvas-card);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    padding: var(--space-xl);

    p {
      margin: 0 0 var(--space-md);
    }
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-md);
    margin-top: auto;
    padding-top: var(--space-md);
  }

  .head {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-md);
    margin: 0 0 var(--space-sm);

    h3 {
      margin: 0;
    }
  }

  .badge {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    border: 1px solid var(--accent);
    border-radius: var(--radius-pill);
    padding: var(--space-xs) var(--space-md);
    white-space: nowrap;
    margin-left: auto;
  }

  .audience {
    font-size: 0.875rem;
    color: var(--mute);
  }

  .kicker {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .points {
    list-style: none;
    margin: 0 0 var(--space-md);
    padding: 0;
    font-size: 0.875rem;

    li {
      display: flex;
      align-items: flex-start;
      gap: var(--space-sm);
    }

    svg {
      flex-shrink: 0;
      margin-top: 4px;
    }

    .pro svg {
      color: var(--accent);
    }

    .con svg {
      color: var(--mute);
    }
  }
</style>
