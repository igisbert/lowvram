---
import type { LlmResultRow } from "@/types";

interface Props {
  rows: LlmResultRow[];
}

const { rows } = Astro.props;

const columns: { key: keyof LlmResultRow; label: string }[] = [
  { key: "model", label: "Modelo" },
  { key: "quantization", label: "Cuantización" },
  { key: "context", label: "Contexto" },
  { key: "genSpeed", label: "T/s gen." },
  { key: "promptSpeed", label: "T/s prompt" },
  { key: "vramUsed", label: "VRAM usada" },
  { key: "gpuLayers", label: "Capas en GPU" },
];
---

{rows.length === 0 ? (
  <div class="empty" role="status">
    <p class="mono">Sin resultados todavía</p>
    <p>TODO: sustituir por datos reales. Cuando midas tus modelos, añade una entrada al array y aparecerá aquí.</p>
  </div>
) : (
  <div class="scroller" tabindex="0" role="region" aria-label="Resultados de LLM, tabla con scroll horizontal">
    <table class="results mono" data-sortable>
      <thead>
        <tr>
          {columns.map((col, i) => (
            <th scope="col" aria-sort={i === 0 ? "ascending" : "none"}>
              <button type="button" data-sort={col.key}>
                {col.label} <span aria-hidden="true">↕</span>
              </button>
            </th>
          ))}
        </tr>
      </thead>
      <tbody>
        {rows.map((row) => (
          <tr>
            <td>{row.model}</td>
            <td>{row.quantization}</td>
            <td>{row.context}</td>
            <td>{row.genSpeed}</td>
            <td>{row.promptSpeed}</td>
            <td>{row.vramUsed}</td>
            <td>{row.gpuLayers}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
)}

<script>
  for (const table of document.querySelectorAll<HTMLTableElement>("table[data-sortable]")) {
    const headers = [...table.querySelectorAll<HTMLButtonElement>("th button")];
    const body = table.querySelector("tbody");
    if (!body) continue;

    headers.forEach((button) => {
      button.addEventListener("click", () => {
        const key = button.dataset.sort ?? "";
        const index = headers.indexOf(button);
        const th = button.closest("th");
        const current = th?.getAttribute("aria-sort") ?? "none";
        const ascending = current !== "ascending";

        for (const h of table.querySelectorAll("th")) h.setAttribute("aria-sort", "none");
        th?.setAttribute("aria-sort", ascending ? "ascending" : "descending");

        const rows = [...body.querySelectorAll("tr")];
        rows.sort((a, b) => {
          const x = a.children[index]?.textContent?.trim() ?? "";
          const y = b.children[index]?.textContent?.trim() ?? "";
          return ascending
            ? x.localeCompare(y, "es", { numeric: true })
            : y.localeCompare(x, "es", { numeric: true });
        });
        body.replaceChildren(...rows);
      });
    });
  }
</script>

<style>
  .scroller {
    overflow-x: auto;
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
  }

  .results {
    width: 100%;
    min-width: 720px;
    border-collapse: collapse;
    font-size: 0.8125rem;
    background: var(--canvas-card);

    th {
      background: var(--canvas-soft);
      text-align: left;
    }

    th,
    td {
      padding: var(--space-md) var(--space-lg);
      border-bottom: 1px solid var(--hairline);
      white-space: nowrap;
    }

    tbody tr:last-child td {
      border-bottom: 0;
    }

    th button {
      all: unset;
      cursor: pointer;
      display: inline-flex;
      gap: var(--space-xs);
      align-items: center;
      font: inherit;
      text-transform: uppercase;
      font-size: 0.75rem;
      letter-spacing: 0.08em;
      color: var(--ink);
      min-height: 44px;
    }

    th button:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 2px;
    }

    td {
      color: var(--body);
    }

    td:first-child {
      color: var(--ink);
    }
  }

  .empty {
    background: var(--canvas-soft);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    padding: var(--space-3xl);
    text-align: center;

    p:first-child {
      color: var(--ink);
      text-transform: uppercase;
      font-size: 0.75rem;
      letter-spacing: 0.08em;
    }

    p:last-child {
      color: var(--mute);
      font-size: 0.875rem;
      margin-inline: auto;
    }
  }
</style>
