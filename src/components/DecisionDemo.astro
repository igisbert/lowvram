---
import { Clock, Cpu } from "@lucide/astro";
import { highlightJson } from "@/utils/highlight";

interface Props {
  input: string;
  output: string;
  model: string;
  runner?: string;
  duration?: string;
  conclusion?: string;
}

const { input, output, model, runner, duration, conclusion } = Astro.props;
---

<figure class="demo-card">
  <div class="demo-head">
    <p class="demo-model">{model}</p>
    {(runner || duration) && (
      <div class="demo-facts">
        {runner && (
          <span>
            <Cpu size={14} />
            {runner}
          </span>
        )}
        {duration && (
          <span>
            <Clock size={14} />
            {duration}
          </span>
        )}
      </div>
    )}
  </div>
  <div class="panels">
    <div class="panel">
      <p class="demo-label">Entrada</p>
      <pre class="demo-output" set:html={highlightJson(input)} />
    </div>
    <div class="panel">
      <p class="demo-label">Salida</p>
      <pre class="demo-output" set:html={highlightJson(output)} />
    </div>
  </div>
  {conclusion && <p class="conclusion">{conclusion}</p>}
</figure>

<style>
  .panels {
    display: grid;
    gap: var(--space-md);
  }

  @media (min-width: 48rem) {
    .panels {
      grid-template-columns: 1fr 1fr;
    }
  }

  .demo-output :global(.tok-key) {
    color: var(--accent);
  }

  .demo-output :global(.tok-num) {
    color: #5eead4;
  }

  .demo-output :global(.tok-kw) {
    color: #ff6b6b;
  }

  .conclusion {
    margin: var(--space-lg) 0 0;
    padding-top: var(--space-lg);
    border-top: 1px solid var(--hairline);
    color: var(--ink);
  }
</style>
