---
import { Clock, Cpu } from "@lucide/astro";

interface Props {
  audio: string;
  audioLabel?: string;
  output: string;
  model: string;
  runner?: string;
  duration?: string;
}

const { audio, audioLabel, output, model, runner, duration } = Astro.props;
---

<figure class="demo-card">
  <div class="demo-head">
    <p class="demo-model">{model}</p>
    {(runner || duration) && (
      <div class="demo-facts">
        {runner && (
          <span>
            <Cpu size={14} />
            {runner}
          </span>
        )}
        {duration && (
          <span>
            <Clock size={14} />
            {duration}
          </span>
        )}
      </div>
    )}
  </div>
  <audio controls src={audio}>
    {audioLabel ?? "Audio transcrito"}
  </audio>
  <pre class="demo-output">{output}</pre>
</figure>

<style>
  audio {
    width: 100%;
    display: block;
    margin-bottom: var(--space-lg);
  }
</style>
