---
import Placeholder from "@/components/Placeholder.astro";
import type { SpecItem } from "@/types";

interface Props {
  item: SpecItem;
}

const { item } = Astro.props;
---

<article class="spec">
  {item.photo ? (
    <div class="photo">
      <img src={item.photo} alt={item.photoAlt} loading="lazy" decoding="async" />
    </div>
  ) : (
    <Placeholder label="TODO: foto real" ratio="4 / 3" />
  )}
  <p class="eyebrow label">{item.label}</p>
  <p class="mono value">{item.value}</p>
  {item.detail && <p class="detail">{item.detail}</p>}
</article>

<style>
  .spec {
    background: var(--canvas-card);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    padding: var(--space-xl);
  }

  .photo {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius);
    border: 1px solid var(--hairline);
    background: var(--canvas-soft);

    img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      display: block;
      filter: drop-shadow(10px 10px 8px rgb(0 0 0 / 0.75));
    }
  }

  .label {
    margin: var(--space-lg) 0 var(--space-xs);
  }

  .value {
    color: var(--ink);
    margin: 0;
  }

  .detail {
    color: var(--mute);
    font-size: 0.875rem;
    margin: var(--space-xs) 0 0;
  }
</style>
