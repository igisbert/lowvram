---
import { Quote } from "@lucide/astro";

const jokes = [
  "No hagáis más carteles con ChatGPT, por favor",
  "Hay vida más allá de los modelos frontera",
  "Nos comen los chinos",
  "Sam Altman, suéltame el brazo",
];

const joke = jokes[Math.floor(Math.random() * jokes.length)];
---

<footer class="site-footer">
  <div class="container inner">
    <p class="mono note">lowvram · IA local en hardware modesto</p>
    <blockquote class="joke">
      <span class="quote open" aria-hidden="true"
        ><Quote size={24} stroke-width={1} /></span
      >
      <p class="text">{joke}</p>
    </blockquote>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    border-top: 1px solid var(--hairline);
    padding-block: var(--space-3xl) var(--space-xl);
    color: var(--body);
    font-size: 0.875rem;
  }

  .inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .note {
    color: var(--ink);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0;
  }

  .joke {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin: 0;
    max-width: var(--measure);
    font-size: 1.25rem;
    line-height: 1.5;
  }

  .text {
    margin: 0;
    text-wrap: balance;
  }

  .quote {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    color: var(--accent);
  }

  .quote.open {
    transform: rotate(180deg);
  }
</style>
