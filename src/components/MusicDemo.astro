---
import { Clock, Cpu } from "@lucide/astro";

interface Props {
  src: string;
  model: string;
  runner?: string;
  duration?: string;
  caption?: string;
  lyrics?: string;
  params?: string[];
}

const { src, model, runner, duration, caption, lyrics, params } = Astro.props;
---

<figure class="demo-card">
  <div class="demo-head">
    <p class="demo-model">{model}</p>
    {(runner || duration) && (
      <div class="demo-facts">
        {runner && (
          <span>
            <Cpu size={14} />
            {runner}
          </span>
        )}
        {duration && (
          <span>
            <Clock size={14} />
            {duration}
          </span>
        )}
      </div>
    )}
  </div>
  {caption && (
    <div class="block">
      <p class="demo-label">Estilo</p>
      <p class="caption">{caption}</p>
    </div>
  )}
  {lyrics && (
    <div class="block">
      <p class="demo-label">Letra</p>
      <pre class="demo-output">{lyrics}</pre>
    </div>
  )}
  {params && (
    <div class="block">
      <p class="demo-label">Parámetros</p>
      <p class="params">{params.join(" · ")}</p>
    </div>
  )}
  <audio controls src={src}>
    Audio generado con {model}
  </audio>
</figure>

<style>
  .block {
    margin-bottom: var(--space-lg);
  }

  .caption {
    margin: 0;
    background: var(--canvas-soft);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    padding: var(--space-md) var(--space-lg);
  }

  .params {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--body);
  }

  audio {
    width: 100%;
    display: block;
  }
</style>
