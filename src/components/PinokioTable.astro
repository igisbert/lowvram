---
import { Link } from "@lucide/astro";
import type { PinokioApp } from "@/types";

interface Props {
  items: PinokioApp[];
}

const { items } = Astro.props;
---

<div class="scroller" tabindex="0" role="region" aria-label="Apps de Pinokio, tabla con scroll horizontal">
  <table class="apps mono">
    <thead>
      <tr>
        <th scope="col"><span class="col-label">Nombre</span></th>
        <th scope="col"><span class="col-label">Para qué sirve</span></th>
        <th scope="col"><span class="col-label">Enlace</span></th>
      </tr>
    </thead>
    <tbody>
      {
        items.map((app) => (
          <tr>
            <td>{app.name}</td>
            <td class="purpose">{app.purpose}</td>
            <td>
              <a
                class="icon-link"
                href={app.url}
                target="_blank"
                rel="noopener"
                aria-label={`${app.name}: abrir enlace externo`}
              >
                <Link size={16} />
              </a>
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .scroller {
    overflow-x: auto;
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
  }

  .apps {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.8125rem;
    background: var(--canvas-card);

    th {
      background: var(--canvas-soft);
      text-align: left;
    }

    th,
    td {
      padding: var(--space-md) var(--space-lg);
      border-bottom: 1px solid var(--hairline);
      white-space: nowrap;
    }

    tbody tr:last-child td {
      border-bottom: 0;
    }

    .col-label {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      text-transform: uppercase;
      font-size: 0.75rem;
      letter-spacing: 0.08em;
      color: var(--ink);
    }

    td {
      color: var(--body);
    }

    td:first-child {
      color: var(--ink);
    }

    .purpose {
      white-space: normal;
      min-width: 220px;
    }

    .icon-link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 44px;
      min-height: 44px;
      color: var(--ink);
    }

    a {
      color: var(--ink);
    }
  }
</style>
