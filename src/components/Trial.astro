---
import { ChevronDown, Clock, Cpu, Gauge, ScrollText } from "@lucide/astro";
import type { TrialRunner } from "@/types";

interface Props {
  title: string;
  model?: string;
  fullModel?: string;
  runner?: TrialRunner;
  tokens?: string;
  duration?: string;
  speed?: string;
}

const { title, model, fullModel, runner, tokens, duration, speed } = Astro.props;
---

<details class="trial">
  <summary>
    <span class="t">{title}{model ? ` · ${model}` : ""}</span>
    <ChevronDown size={18} class="chev" />
  </summary>
  <div class="body">
    {(fullModel || runner || tokens || duration || speed) && (
      <div class="trial-head">
        {fullModel && <p class="mono eyebrow">Modelo · {fullModel}</p>}
        <div class="facts mono">
          {runner && (
            <span><Cpu size={14} />{runner}</span>
          )}
          {tokens && (
            <span><ScrollText size={14} />{tokens}</span>
          )}
          {duration && (
            <span><Clock size={14} />{duration}</span>
          )}
          {speed && (
            <span><Gauge size={14} />{speed}</span>
          )}
        </div>
      </div>
    )}
    <slot />
  </div>
</details>

<style>
  .trial {
    background: var(--canvas-card);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
  }

  .trial + .trial {
    margin-top: var(--space-lg);
  }

  summary {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-md) var(--space-lg);
    min-height: 56px;
    cursor: pointer;
    list-style: none;
    color: var(--ink);
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .t {
    margin-right: auto;
  }

  .chev {
    flex-shrink: 0;
    color: var(--mute);
    transition: transform 160ms ease-out;
  }

  .trial[open] .chev {
    transform: rotate(180deg);
  }

  .body {
    padding: 0 var(--space-lg) var(--space-lg);
  }

  .trial-head {
    margin-bottom: var(--space-xl);

    .eyebrow {
      margin: 0 0 var(--space-sm);
    }
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-xl);
    font-size: 0.8125rem;
    color: var(--ink);

    span {
      display: inline-flex;
      align-items: center;
      gap: var(--space-xs);
    }

    svg {
      color: var(--accent);
      flex-shrink: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .chev {
      transition: none;
    }
  }
</style>
