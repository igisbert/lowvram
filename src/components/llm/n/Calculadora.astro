---
// No se necesita configuración extra para este componente.
const faqData = [
  {
    question: "¿Qué es Astro?",
    answer:
      "Astro es un framework de renderizado estático que genera sitios web rápidos, seguros y totalmente controlados por HTML."
  },
  {
    question: "¿Cómo se crea una página con Astro?",
    answer:
      "Creas archivos `.astro` que contienen markup. El archivo `index.astro` sirve como raíz y importa los componentes que necesites."
  },
  {
    question: "¿Se pueden usar CSS nativo en Astro?",
    answer:
      "Sí. Puedes escribir estilos dentro de una etiqueta `<style>` o en un módulo JS; todo queda encapsulado en el componente."
  },
  {
    question: "¿Qué ventajas tiene el enfoque “islands”?",
    answer:
      "Solo se renderiza el código necesario, lo que reduce el JavaScript total y mejora el rendimiento y la SEO."
  },
  {
    question: "¿Cómo se maneja la interacción en JavaScript vanilla?",
    answer:
      "Se pueden usar eventos directos sobre los botones; no se requieren librerías externas."
  }
];
---
<div class="faq">
  <h2 class="faq__title">Preguntas frecuentes</h2>

  <ul class="faq__list">
    {faqData.map((item, i) => {
        const answerId = `faq-answer-${i + 1}`;
        return `
          <li class="faq__item">
            <button
              class="faq__question"
              aria-expanded="false"
              aria-controls="${answerId}"
              data-index="${i}"
            >
              ${item.question}
            </button>
            <div
              id="${answerId}"
              class="faq__answer"
              hidden
            >
              ${item.answer}
            </div>
          </li>
        `;
      })}
  </ul>
</div>

<style>
  :root {
    --bg: #1e1e1e;
    --text: #f5f5f5;
    --accent: #ff6b6b;
    --border: #333;
  }

  .faq {
    background: var(--bg);
    color: var(--text);
    padding: 1.5rem;
    border-radius: 8px;
    max-width: 680px;
    margin: 0 auto;
    font-family: system-ui, -apple-system, sans-serif;
  }

  .faq__title {
    font-size: 1.75rem;
    margin: 0 0 1rem;
    text-align: center;
  }

  .faq__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .faq__item {
    border-top: 1px solid var(--border);
    margin-top: 1rem;
  }

  .faq__question {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.9rem;
    background: transparent;
    border: none;
    color: var(--text);
    font-size: 1rem;
    cursor: pointer;
    text-align: left;
    transition: background 0.2s;
  }

  .faq__question:hover,
  .faq__question:focus {
    background: rgba(255, 107, 107, 0.1);
    outline: none;
    box-shadow: inset 0 0 0 2px var(--accent);
  }

  .faq__answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
    color: #ccc;
    margin-top: 0.5rem;
    line-height: 1.5;
  }

  .faq__answer.faq__open {
    max-height: 500px; /* suficientemente alto para la mayor respuesta */
  }

  /* Responsive adjustments */
  @media (max-width: 480px) {
    .faq {
      padding: 1rem;
      margin: 0.5rem;
    }
    .faq__title {
      font-size: 1.4rem;
    }
    .faq__question {
      font-size: 0.95rem;
      padding: 0.8rem;
    }
  }
</style>

<script>
  // Todo el comportamiento interactivo está aquí, sin variables globales.
  document.addEventListener('DOMContentLoaded', () => {
    const questions = document.querySelectorAll('.faq__question');

    questions.forEach(btn => {
      btn.addEventListener('click', () => {
        const answer = document.getElementById(
          `faq-answer-${btn.dataset.index}`
        );
        const isOpen = answer.classList.contains('faq__open');

        // Cerrar todas las respuestas
        document.querySelectorAll('.faq__answer')
          .forEach(a => a.classList.remove('faq__open'));
        document.querySelectorAll('.faq__question')
          .forEach(b => b.setAttribute('aria-expanded', 'false'));

        // Si la que se pulsó estaba cerrada, abrirla
        if (!isOpen) {
          answer.classList.add('faq__open');
          btn.setAttribute('aria-expanded', 'true');
        }
      });
    });
  });
</script>
