---

---

<div class="qwen-snake">
  <div class="qwen-snake__header">
    <div class="qwen-snake__score">
      Puntos: <span class="qwen-snake__score-value">0</span>
    </div>
    <div class="qwen-snake__high-score">
      Mejor: <span class="qwen-snake__high-score-value">0</span>
    </div>
  </div>

  <div class="qwen-snake__canvas-wrap">
    <canvas class="qwen-snake__canvas"></canvas>
    <div class="qwen-snake__overlay" aria-hidden="true"></div>
  </div>

  <div class="qwen-snake__controls" aria-label="Controles táctiles">
    <button class="qwen-snake__btn qwen-snake__btn--up" aria-label="Subir"
      >▲</button
    >
    <button class="qwen-snake__btn qwen-snake__btn--down" aria-label="Bajar"
      >▼</button
    >
    <button class="qwen-snake__btn qwen-snake__btn--left" aria-label="Izquierda"
      >◀</button
    >
    <button class="qwen-snake__btn qwen-snake__btn--right" aria-label="Derecha"
      >▶</button
    >
  </div>
</div>

<style>
  .qwen-snake {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding: 16px;
    max-width: 500px;
    margin: 0 auto;
    font-family: system-ui, sans-serif;
    color: #e0e0e0;
    user-select: none;
    -webkit-user-select: none;
    touch-action: manipulation;
  }

  .qwen-snake__header {
    display: flex;
    justify-content: space-between;
    width: 100%;
    max-width: 400px;
    font-size: 14px;
    line-height: 1.4;
  }

  .qwen-snake__score,
  .qwen-snake__high-score {
    background: #1a1a1a;
    padding: 6px 12px;
    border-radius: 6px;
  }

  .qwen-snake__score-value,
  .qwen-snake__high-score-value {
    font-weight: 700;
    color: #4ade80;
  }

  .qwen-snake__canvas-wrap {
    position: relative;
    width: 100%;
    max-width: 400px;
    aspect-ratio: 1;
  }

  .qwen-snake__canvas {
    display: block;
    width: 100%;
    height: 100%;
    background: #0d0d0d;
    border-radius: 8px;
    cursor: pointer;
    outline: none;
  }

  .qwen-snake__canvas:focus-visible {
    box-shadow: 0 0 0 3px #4ade80;
  }

  .qwen-snake__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.7);
    color: #e0e0e0;
    font-size: 16px;
    text-align: center;
    line-height: 1.5;
    border-radius: 8px;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.2s;
  }

  .qwen-snake__overlay--visible {
    opacity: 1;
    pointer-events: none;
  }

  .qwen-snake__controls {
    display: none;
    grid-template-areas:
      ".  up  ."
      "left . right"
      ".  down .";
    grid-template-columns: repeat(3, 44px);
    grid-template-rows: repeat(3, 44px);
    gap: 6px;
    justify-content: center;
  }

  .qwen-snake__btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1px solid #333;
    border-radius: 8px;
    background: #1a1a1a;
    color: #e0e0e0;
    font-size: 18px;
    cursor: pointer;
    outline: none;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }

  .qwen-snake__btn:focus-visible {
    box-shadow: 0 0 0 3px #4ade80;
  }

  .qwen-snake__btn:active {
    background: #2a2a2a;
  }

  .qwen-snake__btn--up {
    grid-area: up;
  }

  .qwen-snake__btn--down {
    grid-area: down;
  }

  .qwen-snake__btn--left {
    grid-area: left;
  }

  .qwen-snake__btn--right {
    grid-area: right;
  }

  @media (pointer: coarse) {
    .qwen-snake__controls {
      display: grid;
    }
  }

  @media (max-width: 480px) {
    .qwen-snake {
      padding: 8px;
    }

    .qwen-snake__controls {
      display: grid;
    }
  }
</style>

<script>
  // @ts-nocheck
  (() => {
    const game = document.querySelector(".qwen-snake");
    const canvas = game.querySelector(".qwen-snake__canvas");
    const ctx = canvas.getContext("2d");
    const overlay = game.querySelector(".qwen-snake__overlay");
    const scoreEl = game.querySelector(".qwen-snake__score-value");
    const highScoreEl = game.querySelector(".qwen-snake__high-score-value");
    const btnUp = game.querySelector(".qwen-snake__btn--up");
    const btnDown = game.querySelector(".qwen-snake__btn--down");
    const btnLeft = game.querySelector(".qwen-snake__btn--left");
    const btnRight = game.querySelector(".qwen-snake__btn--right");

    const GRID = 20;
    let tileSize, tileCount;

    function resizeCanvas() {
      const wrap = canvas.parentElement;
      const size = Math.min(wrap.clientWidth, wrap.clientHeight);
      canvas.width = size;
      canvas.height = size;
      tileSize = size / GRID;
      tileCount = GRID;
    }

    resizeCanvas();
    window.addEventListener("resize", resizeCanvas);

    let snake,
      direction,
      nextDirection,
      food,
      score,
      highScore,
      gameRunning,
      gamePaused,
      gameOver,
      loopTimer,
      speed,
      moveCounter,
      lastDirectionChange;

    highScore = parseInt(localStorage.getItem("snake-high-score") || "0", 10);

    function initGame() {
      snake = [{ x: 10, y: 10 }];
      direction = { x: 0, y: 0 };
      nextDirection = { x: 0, y: 0 };
      score = 0;
      speed = 150;
      gameRunning = false;
      gamePaused = false;
      gameOver = false;
      moveCounter = 0;
      lastDirectionChange = null;
      scoreEl.textContent = "0";
      highScoreEl.textContent = highScore;
      overlay.classList.remove("qwen-snake__overlay--visible");
      overlay.textContent = "Haz clic o pulsa una tecla para empezar";
      overlay.classList.add("qwen-snake__overlay--visible");
      placeFood();
      draw();
    }

    function placeFood() {
      let fx, fy, valid;
      do {
        fx = Math.floor(Math.random() * tileCount);
        fy = Math.floor(Math.random() * tileCount);
        valid = true;
        for (let i = 0; i < snake.length; i++) {
          if (snake[i].x === fx && snake[i].y === fy) {
            valid = false;
            break;
          }
        }
      } while (!valid);
      food = { x: fx, y: fy };
    }

    function draw() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      // Grid lines
      ctx.strokeStyle = "#1a1a1a";
      ctx.lineWidth = 0.5;
      for (let i = 0; i <= tileCount; i++) {
        ctx.beginPath();
        ctx.moveTo(i * tileSize, 0);
        ctx.lineTo(i * tileSize, canvas.height);
        ctx.stroke();
        ctx.beginPath();
        ctx.moveTo(0, i * tileSize);
        ctx.lineTo(canvas.width, i * tileSize);
        ctx.stroke();
      }

      // Food
      ctx.fillStyle = "#ef4444";
      ctx.beginPath();
      ctx.arc(
        food.x * tileSize + tileSize / 2,
        food.y * tileSize + tileSize / 2,
        tileSize / 2 - 2,
        0,
        Math.PI * 2,
      );
      ctx.fill();

      // Snake
      for (let i = 0; i < snake.length; i++) {
        const sx = snake[i].x * tileSize;
        const sy = snake[i].y * tileSize;
        const r = tileSize / 4;

        if (i === 0) {
          ctx.fillStyle = "#4ade80";
        } else {
          const t = i / snake.length;
          const g = Math.round(180 + 60 * t);
          ctx.fillStyle = `rgb(30, ${g}, 60)`;
        }

        ctx.beginPath();
        ctx.roundRect(sx + 1, sy + 1, tileSize - 2, tileSize - 2, r);
        ctx.fill();
      }
    }

    function update() {
      if (!gameRunning || gamePaused || gameOver) return;

      direction = nextDirection;

      const head = { x: snake[0].x + direction.x, y: snake[0].y + direction.y };

      // Wall collision
      if (
        head.x < 0 ||
        head.x >= tileCount ||
        head.y < 0 ||
        head.y >= tileCount
      ) {
        endGame();
        return;
      }

      // Self collision
      for (let i = 0; i < snake.length; i++) {
        if (snake[i].x === head.x && snake[i].y === head.y) {
          endGame();
          return;
        }
      }

      snake.unshift(head);

      if (head.x === food.x && head.y === food.y) {
        score++;
        scoreEl.textContent = score;

        if (score > highScore) {
          highScore = score;
          highScoreEl.textContent = highScore;
          localStorage.setItem("snake-high-score", highScore);
        }

        moveCounter++;
        if (moveCounter % 5 === 0) {
          speed = Math.max(50, speed - 10);
        }

        placeFood();
      } else {
        snake.pop();
      }

      draw();
    }

    function endGame() {
      gameRunning = false;
      gameOver = true;
      if (loopTimer) {
        clearTimeout(loopTimer);
        loopTimer = null;
      }
      overlay.textContent = `Game Over — Puntos: ${score}`;
      overlay.classList.add("qwen-snake__overlay--visible");
    }

    function gameTick() {
      update();
      if (gameRunning && !gamePaused && !gameOver) {
        loopTimer = setTimeout(gameTick, speed);
      }
    }

    function startGame() {
      if (!gameRunning || gameOver) {
        initGame();
        gameRunning = true;
        gameOver = false;
        direction = { x: 0, y: -1 };
        nextDirection = { x: 0, y: -1 };
        lastDirectionChange = { x: 0, y: -1 };
        overlay.classList.remove("qwen-snake__overlay--visible");
        gameTick();
        return;
      }

      if (gamePaused) {
        gamePaused = false;
        overlay.classList.remove("qwen-snake__overlay--visible");
        gameTick();
      }
    }

    function setDirection(dx, dy) {
      if (!gameRunning && !gameOver) {
        startGame();
        return;
      }

      if (gameOver) {
        startGame();
        return;
      }

      if (gamePaused) {
        setDirection(dx, dy);
        return;
      }

      if (gameRunning && !gamePaused) {
        const last = lastDirectionChange;
        if (dx !== 0 && last.x !== 0) return;
        if (dy !== 0 && last.y !== 0) return;

        nextDirection = { x: dx, y: dy };
        lastDirectionChange = { x: dx, y: dy };
      }
    }

    // Keyboard handler
    function handleKey(e) {
      const key = e.key;
      const handledKeys = [
        "ArrowUp",
        "ArrowDown",
        "ArrowLeft",
        "ArrowRight",
        " ",
        "Enter",
        "w",
        "a",
        "s",
        "d",
      ];

      if (!handledKeys.includes(key)) return;

      if (key === " " || key === "Escape") {
        e.preventDefault();
        if (gameOver) {
          initGame();
          return;
        }
        if (gameRunning) {
          gamePaused = !gamePaused;
          if (gamePaused) {
            overlay.textContent = "Pausado";
            overlay.classList.add("qwen-snake__overlay--visible");
          } else {
            overlay.classList.remove("qwen-snake__overlay--visible");
            gameTick();
          }
        }
        return;
      }

      if (key === "Enter") {
        e.preventDefault();
        if (gameOver || !gameRunning) {
          initGame();
          startGame();
        }
        return;
      }

      let dx = 0,
        dy = 0;
      if (key === "ArrowUp" || key === "w" || key === "W") {
        dy = -1;
      } else if (key === "ArrowDown" || key === "s" || key === "S") {
        dy = 1;
      } else if (key === "ArrowLeft" || key === "a" || key === "A") {
        dx = -1;
      } else if (key === "ArrowRight" || key === "d" || key === "D") {
        dx = 1;
      } else return;

      e.preventDefault();
      setDirection(dx, dy);
    }

    canvas.addEventListener("keydown", handleKey);
    canvas.setAttribute("tabindex", "0");

    // Click to start
    canvas.addEventListener("click", () => {
      canvas.focus();
      if (!gameRunning || gameOver) {
        startGame();
      }
    });

    // Touch buttons
    btnUp.addEventListener("click", () => {
      canvas.focus();
      setDirection(0, -1);
    });
    btnDown.addEventListener("click", () => {
      canvas.focus();
      setDirection(0, 1);
    });
    btnLeft.addEventListener("click", () => {
      canvas.focus();
      setDirection(-1, 0);
    });
    btnRight.addEventListener("click", () => {
      canvas.focus();
      setDirection(1, 0);
    });

    // Lose focus → pause
    canvas.addEventListener("blur", () => {
      if (gameRunning && !gamePaused && !gameOver) {
        gamePaused = true;
        overlay.textContent = "Pausado";
        overlay.classList.add("qwen-snake__overlay--visible");
      }
    });

    // Restore focus → unpause
    canvas.addEventListener("focus", () => {
      if (gamePaused && !gameOver) {
        gamePaused = false;
        overlay.classList.remove("qwen-snake__overlay--visible");
        gameTick();
      }
    });

    initGame();
  })();
</script>
