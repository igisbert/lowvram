<style>
  .calc {
    background: #1c1c1c;
    padding: 20px;
    border-radius: 16px;
    width: 340px;
    max-width: 100%;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    font-family:
      system-ui,
      -apple-system,
      sans-serif;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  .calc__display {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    padding: 16px 12px;
    background: #000;
    border-radius: 12px;
    margin-bottom: 16px;
    overflow-x: auto;
  }

  .calc__expr {
    color: #888;
    font-size: 16px;
    min-height: 20px;
    word-break: break-all;
    text-align: right;
    margin-bottom: 4px;
    line-height: 1.2;
  }

  .calc__result {
    color: #fff;
    font-size: 32px;
    font-weight: 300;
    line-height: 1.2;
    white-space: nowrap;
  }

  .calc__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
  }

  .calc__btn {
    background: #2a2a2a;
    color: #fff;
    border: none;
    border-radius: 50%;
    font-size: 20px;
    font-weight: 400;
    min-height: 48px;
    min-width: 48px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition:
      background 0.15s,
      transform 0.1s;
    outline: none;
    touch-action: manipulation;
  }

  .calc__btn:hover {
    background: #3a3a3a;
  }

  .calc__btn:active {
    transform: scale(0.95);
    background: #4a4a4a;
  }

  .calc__btn:focus-visible {
    box-shadow: 0 0 0 2px #ff9500;
  }

  .calc__btn--clear {
    background: #ff6b6b;
  }
  .calc__btn--clear:hover {
    background: #ff5252;
  }
  .calc__btn--clear:active {
    background: #d32f2f;
  }

  .calc__btn--op,
  .calc__btn--eq {
    background: #ff9f00;
  }
  .calc__btn--op:hover,
  .calc__btn--eq:hover {
    background: #ff8c00;
  }
  .calc__btn--op:active,
  .calc__btn--eq:active {
    background: #d97700;
  }

  .calc__btn--wide {
    grid-column: span 2;
    border-radius: 24px;
    min-width: 100%;
  }

  @media (max-width: 400px) {
    .calc {
      width: 100%;
      padding: 16px;
    }
    .calc__btn {
      min-height: 44px;
      min-width: 44px;
      font-size: 18px;
    }
    .calc__result {
      font-size: 28px;
    }
  }
</style>

<div class="calc">
  <div class="calc__display">
    <div class="calc__expr" aria-hidden="true"></div>
    <div class="calc__result" aria-live="polite">0</div>
  </div>
  <div class="calc__grid" role="grid">
    <button
      class="calc__btn calc__btn--clear"
      data-type="clear"
      aria-label="Limpiar">C</button
    >
    <button
      class="calc__btn calc__btn--back"
      data-type="back"
      aria-label="Borrar último dígito">⌫</button
    >
    <button
      class="calc__btn calc__btn--op"
      data-type="operator"
      data-value="/"
      aria-label="Dividir">÷</button
    >
    <button
      class="calc__btn calc__btn--op"
      data-type="operator"
      data-value="*"
      aria-label="Multiplicar">×</button
    >

    <button
      class="calc__btn calc__btn--num"
      data-type="digit"
      data-value="7"
      aria-label="7">7</button
    >
    <button
      class="calc__btn calc__btn--num"
      data-type="digit"
      data-value="8"
      aria-label="8">8</button
    >
    <button
      class="calc__btn calc__btn--num"
      data-type="digit"
      data-value="9"
      aria-label="9">9</button
    >
    <button
      class="calc__btn calc__btn--op"
      data-type="operator"
      data-value="-"
      aria-label="Restar">−</button
    >

    <button
      class="calc__btn calc__btn--num"
      data-type="digit"
      data-value="4"
      aria-label="4">4</button
    >
    <button
      class="calc__btn calc__btn--num"
      data-type="digit"
      data-value="5"
      aria-label="5">5</button
    >
    <button
      class="calc__btn calc__btn--num"
      data-type="digit"
      data-value="6"
      aria-label="6">6</button
    >
    <button
      class="calc__btn calc__btn--op"
      data-type="operator"
      data-value="+"
      aria-label="Sumar">+</button
    >

    <button
      class="calc__btn calc__btn--num"
      data-type="digit"
      data-value="1"
      aria-label="1">1</button
    >
    <button
      class="calc__btn calc__btn--num"
      data-type="digit"
      data-value="2"
      aria-label="2">2</button
    >
    <button
      class="calc__btn calc__btn--num"
      data-type="digit"
      data-value="3"
      aria-label="3">3</button
    >
    <button
      class="calc__btn calc__btn--eq"
      data-type="equals"
      aria-label="Igual">=</button
    >

    <button
      class="calc__btn calc__btn--num calc__btn--wide"
      data-type="digit"
      data-value="0"
      aria-label="0">0</button
    >
    <button
      class="calc__btn calc__btn--num"
      data-type="decimal"
      aria-label="Punto decimal">.</button
    >
    <button
      class="calc__btn calc__btn--eq"
      data-type="equals"
      aria-label="Igual">=</button
    >
  </div>
</div>

<script>
  (() => {
    const root = document.querySelector(".calc");
    if (!root) return;

    let current = "";
    let result = "0";
    let isNewNum = true;
    let hasError = false;

    const displayExpr = root.querySelector(".calc__expr");
    const displayRes = root.querySelector(".calc__result");
    const grid = root.querySelector(".calc__grid");

    function updateDisplay() {
      displayExpr.textContent = current;
      displayRes.textContent = result;
    }

    function clear() {
      current = "";
      result = "0";
      isNewNum = true;
      hasError = false;
      updateDisplay();
    }

    function backspace() {
      if (hasError) {
        clear();
        return;
      }
      if (isNewNum) {
        if (current.length > 0) {
          current = current.slice(0, -1);
          isNewNum = current.length === 0;
        }
      } else {
        current = current.slice(0, -1);
        if (current === "" || current === "-") isNewNum = true;
      }
      updateDisplay();
    }

    function addDigit(d) {
      if (hasError) clear();
      // Corrección crítica: no sobrescribir 'current' si isNewNum es true, sino concatenar.
      // Esto permite que tras "9+", pulsar "2" dé "9+2" en lugar de solo "2".
      if (current === "0" || current === "-") {
        current = d;
      } else {
        current += d;
      }
      isNewNum = false;
      updateDisplay();
    }

    function addDecimal() {
      if (hasError) clear();
      if (isNewNum) {
        // Corrección: concatenar en lugar de sobrescribir
        current += ".";
        isNewNum = false;
      } else if (!current.includes(".")) {
        current += ".";
      }
      updateDisplay();
    }

    function addOperator(op) {
      if (hasError) clear();
      const last = current.slice(-1);
      if ("+-*/".includes(last) && "+-*/".includes(op)) {
        current = current.slice(0, -1) + op;
      } else {
        current += op;
        isNewNum = true;
      }
      updateDisplay();
    }

    function equals() {
      if (hasError) clear();
      if (!current) return;

      let expr = current;
      // Gestión de expresión incompleta al pulsar igual (ej: "5+")
      if ("+-*/".includes(expr.slice(-1))) {
        expr = expr.slice(0, -1);
      }

      try {
        const val = evaluate(expr);
        result = formatResult(val);
        current = result;
        isNewNum = true;
        hasError = false;
      } catch (e) {
        hasError = true;
        result = "Error";
        current = "";
        isNewNum = true;
      }
      updateDisplay();
    }

    function evaluate(expr) {
      let s = expr.replace(/\s/g, "");
      // Gestión de operadores consecutivos (ej: "5++3", "5+-3")
      s = s.replace(/([\+\-\*\/])([\+\-\*\/])/g, "$2");

      let tokens = [];
      let num = "";
      for (let c of s) {
        if ("0123456789.".includes(c)) num += c;
        else {
          if (num) tokens.push(parseFloat(num));
          num = "";
          tokens.push(c);
        }
      }
      if (num) tokens.push(parseFloat(num));

      let i = 0;

      function parseExpr() {
        let res = parseTerm();
        while (i < tokens.length) {
          const op = tokens[i];
          if (op === "+" || op === "-") {
            i++;
            const r = parseTerm();
            res = op === "+" ? res + r : res - r;
          } else break;
        }
        return res;
      }

      function parseTerm() {
        let res = parseFactor();
        while (i < tokens.length) {
          const op = tokens[i];
          if (op === "*" || op === "/") {
            i++;
            const r = parseFactor();
            res = op === "*" ? res * r : res / r;
          } else break;
        }
        return res;
      }

      function parseFactor() {
        if (tokens[i] === "-") {
          i++;
          return -parseTerm();
        }
        if (tokens[i] === "+") {
          i++;
          return parseTerm();
        }
        if (typeof tokens[i] === "number") return tokens[i++];
        return 0;
      }

      return parseExpr();
    }

    function formatResult(n) {
      // Evita errores de coma flotante en resultados habituales (0.1+0.2 -> 0.3)
      let str = n.toPrecision(14);
      if (Math.abs(n) < 1e15 && Math.abs(n) > 0) {
        str = parseFloat(str).toString();
      }
      return str;
    }

    function handleKey(e) {
      if (hasError) clear();
    }

    grid.addEventListener("click", (e) => {
      handleKey(e);
      const btn = e.target.closest(".calc__btn");
      if (!btn) return;
      const type = btn.dataset.type;
      const val = btn.dataset.value;

      if (type === "digit") addDigit(val);
      else if (type === "decimal") addDecimal();
      else if (type === "operator") addOperator(val);
      else if (type === "equals") equals();
      else if (type === "clear") clear();
      else if (type === "back") backspace();
    });
  })();
</script>
