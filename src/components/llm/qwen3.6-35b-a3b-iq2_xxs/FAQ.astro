---
// components/FAQ.astro
---

<div class="faq-component">
  <div class="faq-item" data-faq-item="1">
    <button
      class="faq-question"
      aria-expanded="false"
      aria-controls="faq-panel-1"
      id="faq-btn-1"
    >
      <span class="faq-question-text">¿Qué es este componente?</span>
      <span class="faq-indicator" aria-hidden="true"></span>
    </button>
    <div class="faq-answer" id="faq-panel-1" role="region">
      <p>
        Este es un componente de preguntas frecuentes construido con Astro,
        JavaScript vanilla y CSS nativo. Está diseñado para ser accesible,
        moderno y ligero, sin dependencias externas.
      </p>
    </div>
  </div>

  <div class="faq-item" data-faq-item="2">
    <button
      class="faq-question"
      aria-expanded="false"
      aria-controls="faq-panel-2"
      id="faq-btn-2"
    >
      <span class="faq-question-text">¿Cómo se implementa la animación?</span>
      <span class="faq-indicator" aria-hidden="true"></span>
    </button>
    <div class="faq-answer" id="faq-panel-2" role="region">
      <p>
        La animación se logra midiendo la altura natural del contenido con
        `scrollHeight` y usando `transition` en CSS. Respetamos
        `prefers-reduced-motion` desactivando las animaciones cuando el usuario
        lo prefiere.
      </p>
    </div>
  </div>

  <div class="faq-item" data-faq-item="3">
    <button
      class="faq-question"
      aria-expanded="false"
      aria-controls="faq-panel-3"
      id="faq-btn-3"
    >
      <span class="faq-question-text">¿Es accesible?</span>
      <span class="faq-indicator" aria-hidden="true"></span>
    </button>
    <div class="faq-answer" id="faq-panel-3" role="region">
      <p>
        Sí. Usa botones semánticos con `aria-expanded` y `aria-controls`. El
        foco es visible y la estructura respeta los patrones de diseño accesible
        para acordeones.
      </p>
    </div>
  </div>

  <div class="faq-item" data-faq-item="4">
    <button
      class="faq-question"
      aria-expanded="false"
      aria-controls="faq-panel-4"
      id="faq-btn-4"
    >
      <span class="faq-question-text">¿Puedo personalizar los estilos?</span>
      <span class="faq-indicator" aria-hidden="true"></span>
    </button>
    <div class="faq-answer" id="faq-panel-4" role="region">
      <p>
        Los estilos están encapsulados bajo la clase `.faq-component`. Puedes
        modificar variables CSS personalizadas para ajustar colores, espaciados
        y tamaños sin romper el diseño.
      </p>
    </div>
  </div>

  <div class="faq-item" data-faq-item="5">
    <button
      class="faq-question"
      aria-expanded="false"
      aria-controls="faq-panel-5"
      id="faq-btn-5"
    >
      <span class="faq-question-text">¿Funciona en móvil?</span>
      <span class="faq-indicator" aria-hidden="true"></span>
    </button>
    <div class="faq-answer" id="faq-panel-5" role="region">
      <p>
        Sí. El diseño es totalmente responsive y se adapta a cualquier tamaño de
        pantalla, desde escritorio hasta dispositivos móviles pequeños.
      </p>
    </div>
  </div>
</div>

<script>
  // @ts-nocheck
  const faqComponent = document.querySelector(".faq-component");

  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  faqComponent.querySelectorAll(".faq-question").forEach((btn) => {
    const panelId = btn.getAttribute("aria-controls");
    const panel = faqComponent.querySelector('[id="' + panelId + '"]');
    if (!panel) return;

    const toggle = () => {
      const isExpanded = btn.getAttribute("aria-expanded") === "true";
      btn.setAttribute("aria-expanded", String(!isExpanded));

      if (!isExpanded) {
        const targetHeight = panel.scrollHeight;
        panel.style.height = prefersReducedMotion
          ? "auto"
          : `${targetHeight}px`;
        panel.style.overflow = "hidden";
        panel.style.opacity = "1";
        panel.setAttribute("aria-hidden", "false");
      } else {
        panel.style.height = "0px";
        panel.style.overflow = "hidden";
        panel.style.opacity = "0";
        panel.setAttribute("aria-hidden", "true");
      }
    };

    btn.addEventListener("click", toggle);
    btn.addEventListener("keydown", (e) => {
      if (e.key === "ArrowDown" || e.key === "ArrowRight") {
        const next = btn.closest(".faq-item").nextElementSibling;
        if (next) {
          e.preventDefault();
          next.querySelector(".faq-question").focus();
        }
      } else if (e.key === "ArrowUp" || e.key === "ArrowLeft") {
        const prev = btn.closest(".faq-item").previousElementSibling;
        if (prev) {
          e.preventDefault();
          prev.querySelector(".faq-question").focus();
        }
      } else if (e.key === "Home") {
        e.preventDefault();
        faqComponent.querySelector(".faq-question").focus();
      } else if (e.key === "End") {
        e.preventDefault();
        const lastBtn = faqComponent
          .querySelectorAll(".faq-question")
          .item(faqComponent.querySelectorAll(".faq-question").length - 1);
        if (lastBtn) lastBtn.focus();
      }
    });
  });
</script>

<style>
  .faq-component {
    --faq-color-bg: #121212;
    --faq-color-surface: #1a1a1a;
    --faq-color-text: #e0e0e0;
    --faq-color-text-muted: #a0a0a0;
    --faq-color-border: #2a2a2a;
    --faq-color-accent: #ffffff;
    --faq-color-focus: #4a9eff;
    --faq-font-size: 1rem;
    --faq-font-size-lg: 1.125rem;
    --faq-padding: 1.25rem 1.5rem;
    --faq-transition-duration: 300ms;
    --faq-transition-ease: cubic-bezier(0.4, 0, 0.2, 1);
    --faq-border-radius: 8px;

    max-width: 800px;
    margin: 0 auto;
    background: var(--faq-color-bg);
    border-radius: var(--faq-border-radius);
    font-family:
      system-ui,
      -apple-system,
      sans-serif;
    font-size: var(--faq-font-size);
    color: var(--faq-color-text);
  }

  .faq-component .faq-item {
    border-bottom: 1px solid var(--faq-color-border);
  }

  .faq-component .faq-item:last-child {
    border-bottom: none;
  }

  .faq-component .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: var(--faq-padding);
    background: transparent;
    border: none;
    color: var(--faq-color-text);
    font-size: var(--faq-font-size-lg);
    font-weight: 600;
    cursor: pointer;
    text-align: left;
    transition: color var(--faq-transition-duration) var(--faq-transition-ease);
    outline: none;
  }

  .faq-component .faq-question:hover {
    color: var(--faq-color-accent);
  }

  .faq-component .faq-question:focus-visible {
    outline: 2px solid var(--faq-color-focus);
    outline-offset: -2px;
    border-radius: var(--faq-border-radius);
  }

  .faq-component .faq-question:focus {
    outline: 2px solid var(--faq-color-focus);
    outline-offset: -2px;
    border-radius: var(--faq-border-radius);
  }

  .faq-component .faq-question-text {
    flex: 1;
    padding-right: 1rem;
  }

  .faq-component .faq-indicator {
    flex-shrink: 0;
    width: 14px;
    height: 14px;
    position: relative;
    transition: transform var(--faq-transition-duration)
      var(--faq-transition-ease);
  }

  .faq-component .faq-indicator::before,
  .faq-component .faq-indicator::after {
    content: "";
    position: absolute;
    background: var(--faq-color-text-muted);
    border-radius: 2px;
    transition:
      background var(--faq-transition-duration) var(--faq-transition-ease),
      transform var(--faq-transition-duration) var(--faq-transition-ease);
  }

  .faq-component .faq-indicator::before {
    width: 14px;
    height: 2px;
    top: 6px;
    left: 0;
  }

  .faq-component .faq-indicator::after {
    width: 2px;
    height: 14px;
    top: 0;
    left: 6px;
  }

  .faq-component .faq-question[aria-expanded="true"] .faq-indicator::after {
    transform: rotate(90deg);
    background: var(--faq-color-accent);
  }

  .faq-component .faq-question[aria-expanded="true"] .faq-indicator::before {
    background: var(--faq-color-accent);
  }

  .faq-component .faq-answer {
    padding: 0 1.5rem;
    overflow: hidden;
    transition:
      height var(--faq-transition-duration) var(--faq-transition-ease),
      opacity var(--faq-transition-duration) var(--faq-transition-ease);
    height: 0;
    opacity: 0;
  }

  .faq-component .faq-answer[aria-hidden="false"] {
    padding: 0 1.5rem 1.25rem;
  }

  .faq-component .faq-answer p {
    margin: 0;
    padding-top: 1rem;
    color: var(--faq-color-text-muted);
    line-height: 1.6;
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-component .faq-question,
    .faq-component .faq-indicator,
    .faq-component .faq-indicator::before,
    .faq-component .faq-indicator::after,
    .faq-component .faq-answer {
      transition: none;
    }
  }

  @media (max-width: 640px) {
    .faq-component {
      --faq-font-size: 0.95rem;
      --faq-font-size-lg: 1.05rem;
      --faq-padding: 1rem 1.25rem;
    }

    .faq-component .faq-answer p {
      font-size: 0.95rem;
    }
  }
</style>
