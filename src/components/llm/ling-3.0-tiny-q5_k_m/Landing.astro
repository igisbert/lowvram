---
// AURA — Landing Component
// Identidad visual: estética editorial, paleta limitada, tipografía expresiva
// Sin elementos externos, sin frameworks, sin JavaScript
---

<!-- Navegación -->
<input type="checkbox" id="nav-toggle" class="nav-toggle" aria-hidden="true">
<label for="nav-toggle" class="hamburger" aria-label="Menú de navegación">
  <span></span><span></span><span></span>
</label>
<nav class="nav" aria-label="Navegación principal" role="navigation">
  <ul class="nav__list">
    <li><a href="#inicio">Inicio</a></li>
    <li><a href="#valor">Valor</a></li>
    <li><a href="#concepto">Concepto</a></li>
    <li><a href="#visual">Visual</a></li>
    <li><a href="#contacto">Contacto</a></li>
  </ul>
</nav>

<!-- Sección 1: Hero -->
<section id="inicio" class="section hero">
  <div class="hero__bg">
    <div class="hero__circle hero__circle--1"></div>
    <div class="hero__circle hero__circle--2"></div>
    <div class="hero__shape hero__shape--1"></div>
  </div>
  <div class="hero__content">
    <h1 class="hero__title">AURA</h1>
    <p class="hero__tagline">Luz que define</p>
    <p class="hero__subtitle">Presencia lumínica en cada punto de contacto</p>
    <a href="#valor" class="hero__cta">Descubrir la diferencia</a>
  </div>
</section>

<!-- Sección 2: Valor -->
<section id="valor" class="section valor">
  <div class="valor__grid">
    <div class="valor__block valor__block--1">
      <div class="valor__circle"></div>
      <h2 class="valor__title">Presencia</h2>
      <p class="valor__desc">Alguien en cada rincón que se siente</p>
    </div>
    <div class="valor__block valor__block--2">
      <div class="valor__triangle"></div>
      <h2 class="valor__title">Eficiencia</h2>
      <p class="valor__desc">Respuesta inmediata a cada necesidad</p>
    </div>
    <div class="valor__block valor__block--3">
      <div class="valor__diamond"></div>
      <h2 class="valor__title">Innovación</h2>
      <p class="valor__desc">Novedad que redefine cada paso</p>
    </div>
  </div>
</section>

<!-- Sección 3: Concepto -->
<section id="concepto" class="section concepto">
  <div class="concepto__grid">
    <div class="concepto__text">
      <h2 class="concepto__heading">La idea que nos define</h2>
      <p class="concepto__body">AURA es un lenguaje visual que trasciende lo convencional. Nace de la observación de lo que importa: la presencia de cada detalle, la intensidad de cada gesto, la claridad de cada decisión.</p>
    </div>
    <div class="concepto__shape"></div>
  </div>
</section>

<!-- Sección 4: Visual -->
<section id="visual" class="section visual">
  <div class="visual__poster">
    <div class="visual__layer visual__layer--1"></div>
    <div class="visual__layer visual__layer--2"></div>
    <div class="visual__layer visual__layer--3"></div>
    <div class="visual__shape visual__shape--1"></div>
    <div class="visual__shape visual__shape--2"></div>
    <div class="visual__shape visual__shape--3"></div>
    <h2 class="visual__title">Un lenguaje sin límites</h2>
    <p class="visual__subtitle">Donde lo geométrico encuentra lo emocional</p>
  </div>
</section>

<!-- Sección 5: Cierre -->
<section id="contacto" class="section cierre">
  <div class="cierre__content">
    <p class="cierre__message">Tu transformación comienza aquí</p>
    <a href="#inicio" class="cierre__cta">Iniciar ahora</a>
  </div>
</section>

<style>
/* ========== RESET ========== */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --bg: #0d0d12;
  --bg-deep: #08080f;
  --accent: #c8965a;
  --accent-dark: #8a6a3a;
  --accent-light: #e8c88c;
  --emerald: #2a6a4a;
  --emerald-dark: #1a4a3a;
  --coral: #d45d3e;
  --coral-dark: #a03a2a;
  --white: #fafaf9;
  --gray: #6a6a7a;
  --gray-dark: #3a3a4a;
  --card-bg: #12121a;
  --border: rgba(200,150,90,0.12);
  --nav-h: 96px;
}

/* ========== NAVIGACIÓN ========== */
.nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  transform: translateY(-100%);
  opacity: 0;
  pointer-events: none;
  transition: transform 0.5s cubic-bezier(0.4,0,0.2,1), opacity 0.5s ease;
  padding: 1rem 2rem;
  background: linear-gradient(180deg, var(--bg) 0%, var(--bg-deep) 100%);
  border-bottom: 1px solid var(--border);
}

.nav-toggle:checked ~ .nav {
  transform: translateY(0);
  opacity: 1;
  pointer-events: all;
}

.nav__list {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 2rem;
  align-items: center;
}

.nav__list a {
  color: var(--white);
  font-family: 'Space Grotesk', 'Inter', -apple-system, sans-serif;
  font-size: 0.85rem;
  letter-spacing: 0.15em;
  text-decoration: none;
  position: relative;
  padding: 0.25rem 0;
  transition: color 0.3s ease;
}

.nav__list a::after {
  content: '';
  position: absolute;
  bottom: -2px;
  left: 0;
  width: 0;
  height: 1px;
  background: var(--accent);
  transition: width 0.3s ease;
}

.nav__list a:hover::after,
.nav__list a:focus::after { width: 100%; }

.nav__list a:focus { outline: 2px solid var(--accent); outline-offset: 4px; border-radius: 2px; }

@media (min-width: 769px) {
  .hamburger { display: none; }
  .nav { transform: translateY(0); opacity: 1; pointer-events: all; }
}

.hamburger {
  display: none;
  position: fixed;
  top: 1rem;
  left: 1.5rem;
  z-index: 110;
  width: 44px;
  height: 44px;
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 10px;
  cursor: pointer;
  align-items: center;
  justify-content: center;
}

.hamburger span {
  display: block;
  width: 22px;
  height: 2px;
  background: var(--accent);
  border-radius: 2px;
  transition: all 0.3s ease;
}

.hamburger span:nth-child(1) { transform: translateY(7px) rotate(0deg); }
.hamburger span:nth-child(2) { transform: translateY(0); opacity: 1; }
.hamburger span:nth-child(3) { transform: translateY(-7px) rotate(0deg); }

.hamburger:checked ~ .hamburger span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
.hamburger:checked ~ .hamburger span:nth-child(2) { opacity: 0; }
.hamburger:checked ~ .hamburger span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

@media (max-width: 768px) {
  .hamburger { display: flex; }
}

/* ========== SECCIÓN 1: HERO ========== */
.hero {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  scroll-margin-top: 96px;
}

.hero__bg {
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse 80% 60% at 50% 40%, rgba(200,150,90,0.06) 0%, transparent 70%);
}

.hero__circle {
  position: absolute;
  border-radius: 50%;
  border: 1px solid rgba(200,150,90,0.08);
  animation: float 8s ease-in-out infinite;
}

.hero__circle--1 {
  width: 400px;
  height: 400px;
  top: -100px;
  right: -100px;
  background: radial-gradient(circle, rgba(200,150,90,0.12) 0%, transparent 70%);
}

.hero__circle--2 {
  width: 250px;
  height: 250px;
  bottom: -50px;
  left: -50px;
  background: radial-gradient(circle, rgba(200,150,90,0.08) 0%, transparent 70%);
  animation-delay: -3s;
}

.hero__shape {
  position: absolute;
  width: 80px;
  height: 80px;
  transform: rotate(45deg);
  background: linear-gradient(135deg, var(--accent) 0%, transparent 60%);
  opacity: 0.08;
  animation: pulse 4s ease-in-out infinite;
}

.hero__shape--1 { top: 10%; left: 5%; }
.hero__shape--2 { bottom: 20%; right: 10%; }

@keyframes float {
  0%, 100% { transform: translateY(0) translateX(0); }
  50% { transform: translateY(-15px) translateX(10px); }
}

@keyframes pulse {
  0%, 100% { opacity: 0.05; transform: scale(1); }
  50% { opacity: 0.12; transform: scale(1.05); }
}

.hero__content {
  position: relative;
  z-index: 2;
  text-align: center;
  max-width: 640px;
  padding: 0 2rem;
}

.hero__title {
  font-family: 'Space Grotesk', 'Inter', -apple-system, sans-serif;
  font-size: clamp(4rem, 12vw, 8rem);
  font-weight: 200;
  letter-spacing: -0.02em;
  color: var(--white);
  line-height: 1;
  margin-bottom: 0.5rem;
}

.hero__tagline {
  font-size: 1.4rem;
  font-weight: 300;
  color: var(--accent);
  letter-spacing: 0.1em;
  margin-bottom: 0.75rem;
}

.hero__subtitle {
  font-size: 1rem;
  color: var(--gray);
  line-height: 1.6;
  margin-bottom: 2rem;
}

.hero__cta {
  display: inline-block;
  padding: 0.85rem 2.5rem;
  background: var(--accent);
  color: var(--bg);
  font-family: 'Space Grotesk', 'Inter', -apple-system, sans-serif;
  font-size: 0.85rem;
  font-weight: 500;
  letter-spacing: 0.1em;
  text-decoration: none;
  border-radius: 4px;
  transition: all 0.3s ease;
  clip-path: polygon(0% 0%, 100% 0%, 100% 85%, 0% 100%);
}

.hero__cta:hover {
  background: var(--accent-light);
  transform: translateY(-2px);
  box-shadow: 0 8px 30px rgba(200,150,90,0.3);
}

.hero__cta:focus { outline: 2px solid var(--white); outline-offset: 4px; }

/* ========== SECCIÓN 2: VALOR ========== */
.valor {
  padding: 8rem 2rem;
  background: var(--bg);
  scroll-margin-top: 96px;
}

.valor__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2.5rem;
  max-width: 1200px;
  margin: 0 auto;
}

.valor__block {
  position: relative;
  padding: 2.5rem;
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: 6px;
  overflow: hidden;
  transition: transform 0.4s ease, border-color 0.4s ease;
}

.valor__block:hover {
  transform: translateY(-4px);
  border-color: rgba(200,150,90,0.3);
}

.valor__block::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(200,150,90,0.03) 0%, transparent 50%);
  pointer-events: none;
}

.valor__block--1 {
  background: linear-gradient(135deg, #12121a 0%, #0d0d12 100%);
}

.valor__block--2 {
  background: linear-gradient(135deg, #12121a 0%, #0d0d12 100%);
}

.valor__block--3 {
  background: linear-gradient(135deg, #12121a 0%, #0d0d12 100%);
}

.valor__circle,
.valor__triangle,
.valor__diamond {
  position: absolute;
  opacity: 0.08;
  background: var(--accent);
}

.valor__circle {
  width: 60px;
  height: 60px;
  top: -10px;
  right: -10px;
  border-radius: 50%;
}

.valor__triangle {
  width: 0;
  height: 0;
  border-left: 35px solid transparent;
  border-right: 35px solid transparent;
  border-bottom: 70px solid var(--emerald);
  bottom: -15px;
  left: 10px;
}

.valor__diamond {
  width: 0;
  height: 0;
  border-left: 35px solid transparent;
  border-right: 35px solid transparent;
  border-bottom: 50px solid var(--coral);
  top: -10px;
  right: 10px;
}

.valor__title {
  font-family: 'Space Grotesk', 'Inter', -apple-system, sans-serif;
  font-size: 1.5rem;
  font-weight: 400;
  color: var(--white);
  margin-bottom: 0.5rem;
  position: relative;
  z-index: 1;
}

.valor__desc {
  font-size: 0.9rem;
  color: var(--gray);
  line-height: 1.5;
  position: relative;
  z-index: 1;
}

/* ========== SECCIÓN 3: CONCEPTO ========== */
.concepto {
  padding: 8rem 2rem;
  background: var(--bg);
  position: relative;
  overflow: hidden;
  scroll-margin-top: 96px;
}

.concepto__grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 4rem;
  max-width: 1200px;
  margin: 0 auto;
  align-items: center;
}

.concepto__text h2 {
  font-family: 'Space Grotesk', 'Inter', -apple-system, sans-serif;
  font-size: 2.5rem;
  font-weight: 300;
  color: var(--white);
  letter-spacing: 0.05em;
  margin-bottom: 1.5rem;
}

.concepto__body {
  font-size: 1.05rem;
  color: var(--gray);
  line-height: 1.8;
  max-width: 520px;
}

.concepto__shape {
  position: absolute;
  width: 300px;
  height: 300px;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: radial-gradient(circle, rgba(200,150,90,0.06) 0%, transparent 70%);
  border-radius: 50%;
}

.concepto__shape::before {
  content: '';
  position: absolute;
  width: 200px;
  height: 200px;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: var(--accent);
  opacity: 0.05;
  border-radius: 50%;
}

.concepto__shape::after {
  content: '';
  position: absolute;
  width: 120px;
  height: 120px;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: var(--emerald);
  opacity: 0.04;
  border-radius: 50%;
}

/* ========== SECCIÓN 4: VISUAL ========== */
.visual {
  padding: 8rem 2rem;
  background: var(--bg);
  position: relative;
  scroll-margin-top: 96px;
}

.visual__poster {
  position: relative;
  width: 100%;
  max-width: 1000px;
  margin: 0 auto;
  min-height: 600px;
  display: flex;
  align-items: center;
  justify-content: center;
  perspective: 1000px;
}

.visual__layer {
  position: absolute;
  inset: 0;
  transition: transform 0.5s ease;
}

.visual__layer--1 {
  background: linear-gradient(135deg, var(--accent) 0%, #2a1a1a 100%);
  clip-path: polygon(0% 0%, 100% 0%, 100% 80%, 60% 100%, 0% 100%);
}

.visual__layer--2 {
  background: linear-gradient(225deg, var(--coral) 0%, #1a0d0d 100%);
  clip-path: polygon(100% 0%, 0% 100%, 100% 100%, 0% 0%);
  opacity: 0.15;
}

.visual__layer--3 {
  background: radial-gradient(ellipse at 30% 20%, var(--emerald) 0%, transparent 50%),
              radial-gradient(ellipse at 70% 80%, var(--accent) 0%, transparent 50%);
  opacity: 0.25;
}

.visual__shape {
  position: absolute;
  width: 120px;
  height: 120px;
  opacity: 0.12;
}

.visual__shape--1 {
  top: 10%;
  left: 15%;
  background: var(--accent);
  border-radius: 36px;
  transform: rotate(15deg) scale(0.8);
}

.visual__shape--2 {
  bottom: 20%;
  right: 20%;
  background: var(--coral);
  border-radius: 50%;
  transform: rotate(-20deg) scale(0.9);
}

.visual__shape--3 {
  top: 50%;
  left: 30%;
  background: var(--emerald);
  width: 80px;
  height: 80px;
  border-radius: 50%;
  transform: rotate(45deg) scale(0.7);
}

.visual__title {
  position: relative;
  z-index: 2;
  font-family: 'Space Grotesk', 'Inter', -apple-system, sans-serif;
  font-size: 3.5rem;
  font-weight: 200;
  color: var(--white);
  letter-spacing: 0.08em;
  text-align: center;
  margin-bottom: 0.5rem;
}

.visual__subtitle {
  font-size: 1rem;
  color: var(--accent);
  letter-spacing: 0.2em;
  text-align: center;
  margin-bottom: 3rem;
}

/* ========== SECCIÓN 5: CIERRE ========== */
.cierre {
  padding: 8rem 2rem;
  background: var(--bg);
  text-align: center;
  scroll-margin-top: 96px;
}

.cierre__content {
  position: relative;
  z-index: 2;
  max-width: 560px;
  margin: 0 auto;
}

.cierre__message {
  font-size: 1.15rem;
  color: var(--gray);
  line-height: 1.7;
  margin-bottom: 2rem;
  letter-spacing: 0.03em;
}

.cierre__cta {
  display: inline-block;
  padding: 0.85rem 2.5rem;
  background: var(--coral);
  color: var(--white);
  font-family: 'Space Grotesk', 'Inter', -apple-system, sans-serif;
  font-size: 0.85rem;
  font-weight: 500;
  letter-spacing: 0.1em;
  text-decoration: none;
  border-radius: 4px;
  transition: all 0.3s ease;
  clip-path: polygon(0% 0%, 100% 0%, 100% 85%, 0% 100%);
}

.cierre__cta:hover {
  background: var(--coral-dark);
  transform: translateY(-2px);
  box-shadow: 0 8px 30px rgba(212,93,62,0.3);
}

.cierre__cta:focus { outline: 2px solid var(--white); outline-offset: 4px; }

/* ========== RESPONSIVE ========== */
@media (max-width: 768px) {
  .valor__grid {
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  .concepto__grid {
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  .concepto__body {
    font-size: 0.95rem;
  }

  .visual__poster {
    min-height: 500px;
  }

  .visual__title {
    font-size: 2rem;
  }

  .visual__shape {
    transform: scale(0.7);
  }

  .hero__content {
    padding: 0 1rem;
  }

  .hero__title {
    font-size: 3rem;
  }

  .hero__tagline {
    font-size: 1.1rem;
  }

  .hero__subtitle {
    font-size: 0.85rem;
  }
}

@media (max-width: 480px) {
  .visual__title {
    font-size: 1.6rem;
  }

  .visual__poster {
    min-height: 400px;
  }

  .visual__shape--1 { width: 80px; height: 80px; }
  .visual__shape--2 { width: 70px; height: 70px; }
  .visual__shape--3 { width: 60px; height: 60px; }

  .concepto__text h2 {
    font-size: 1.8rem;
  }

  .valor__block {
    padding: 1.5rem;
  }

  .hero__title {
    font-size: 2.2rem;
  }
}

/* ========== REDUCED MOTION ========== */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }

  .hero__circle { animation: none; }
  .visual__layer { transition: none; }
}
</style>