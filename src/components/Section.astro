---
interface Props {
  eyebrow?: string;
  title: string;
  id?: string;
}

const { eyebrow, title, id } = Astro.props;
---

<section class="band" id={id}>
  <div class="container">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2>{title}</h2>
    <slot />
  </div>
</section>

<style>
  h2 {
    margin: 0 0 var(--space-xl);
    font-size: clamp(2rem, 3vw, 2.85rem);
  }
</style>
