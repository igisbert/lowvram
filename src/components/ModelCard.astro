---
import { Link as LinkIcon } from "@lucide/astro";
import type { ModelItem } from "@/types";
import { inputsLabel, yesNo } from "@/utils/format";

interface Props {
  item: ModelItem;
}

const { item } = Astro.props;
---

<article class="card">
  <h3>{item.name}</h3>
  <dl class="facts mono">
    <div>
      <dt>Tamaño</dt>
      <dd>{item.size}</dd>
    </div>
    <div>
      <dt>Parámetros</dt>
      <dd>{item.params}</dd>
    </div>
    <div>
      <dt>Cuantización</dt>
      <dd>{item.quantization}</dd>
    </div>
    {item.vram && (
      <div>
        <dt>VRAM aprox.</dt>
        <dd>{item.vram}</dd>
      </div>
    )}
    {item.moe !== undefined && (
      <div>
        <dt>MoE</dt>
        <dd>{yesNo(item.moe)}</dd>
      </div>
    )}
    {item.mtp !== undefined && (
      <div>
        <dt>MTP</dt>
        <dd>{yesNo(item.mtp)}</dd>
      </div>
    )}
    {item.input && (
      <div>
        <dt>Modalidades</dt>
        <dd class="mods">{inputsLabel(item.input)}</dd>
      </div>
    )}
    <div>
      <dt>Enlace</dt>
      <dd>
        <a
          class="icon-link"
          href={item.url}
          target="_blank"
          rel="noopener"
          aria-label={`Descargar ${item.name}`}
        >
          <LinkIcon size={16} />
        </a>
      </dd>
    </div>
  </dl>
  {item.use.trim() !== "" && <p>{item.use}</p>}
  {item.observations && (
    <div class="notes">
      <p class="mono kicker">Observaciones</p>
      <ul>
        {item.observations.map((note) => (
          <li>{note}</li>
        ))}
      </ul>
    </div>
  )}
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--canvas-card);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    padding: var(--space-xl);

    h3 {
      margin: 0 0 var(--space-md);
    }

    p {
      margin: 0 0 var(--space-md);
      font-size: 0.875rem;
      color: var(--body);
    }
  }

  .facts {
    display: grid;
    gap: var(--space-sm);
    margin: 0 0 var(--space-lg);
    font-size: 0.8125rem;

    div {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: var(--space-lg);
      border-bottom: 1px solid var(--hairline);
      padding-bottom: var(--space-sm);
      min-height: 44px;
    }

    dt {
      color: var(--mute);
    }

    dd {
      color: var(--ink);
      margin: 0;
      text-align: right;
    }

    .mods {
      text-transform: capitalize;
    }

    .icon-link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 44px;
      min-height: 44px;
      color: var(--ink);
    }
  }

  .notes {
    border-top: 1px solid var(--hairline);
    padding-top: var(--space-md);
    margin-bottom: var(--space-md);

    .kicker {
      font-size: 0.75rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--accent);
      margin: 0 0 var(--space-sm);
    }

    ul {
      list-style: none;
      margin: 0;
      padding: 0;
      font-size: 0.875rem;
      color: var(--body);
    }

    li + li {
      margin-top: var(--space-xs);
    }
  }
</style>
