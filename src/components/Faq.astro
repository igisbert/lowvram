---
import { faqs } from "@/data/faqs";
---

<section class="band">
  <div class="container">
    <p class="eyebrow">Preguntas frecuentes</p>
    <h2>Dudas rápidas</h2>
    <div class="faq">
      {
        faqs.map(({ question, answer }) => (
          <details name="faq">
            <summary>{question}</summary>
            <p>{answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  h2 {
    margin: 0 0 var(--space-xl);
    font-size: clamp(2rem, 3vw, 2.85rem);
  }

  .faq {
    max-width: var(--measure);
    display: grid;
    gap: var(--space-sm);
  }

  details {
    background: var(--canvas-card);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    padding: var(--space-sm) var(--space-lg);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    min-height: 44px;
    cursor: pointer;
    list-style: none;
    color: var(--ink);
    font-size: 1.0625rem;
    font-weight: 600;

    &::-webkit-details-marker {
      display: none;
    }

    &::after {
      content: "+";
      flex-shrink: 0;
      color: var(--accent);
      font-family: var(--font-mono);
      font-weight: 400;
      font-size: 1.25rem;
      transition: rotate 0.2s ease;
    }

    &:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 2px;
    }
  }

  details[open] summary::after {
    rotate: 45deg;
  }

  details p {
    margin: 0;
    max-width: 75ch;
    padding-block: var(--space-xs) var(--space-sm);
    color: var(--body);
    font-size: 0.9375rem;
    line-height: 1.65;
  }
</style>
