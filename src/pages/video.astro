---
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import ModelList from "@/components/ModelList.astro";
import Section from "@/components/Section.astro";
import SoftwareList from "@/components/SoftwareList.astro";
import VideoResults from "@/components/VideoResults.astro";
import { videoModels } from "@/data/models";
import { videoSoftware } from "@/data/software";
import { videoResults } from "@/data/video-results";
import Layout from "@/layouts/Layout.astro";
---

<Layout
  title="Modelos de vídeo"
  description="Software, modelos recomendados y resultados de generación de vídeo ejecutada en local en una RTX 2070 con 8 GB de VRAM."
>
  <Header />
  <main id="main">
    <div class="container page-head">
      <p class="eyebrow">Vídeo · Generación local</p>
      <h1>Modelos de vídeo</h1>
      <p class="lead">
        Con qué generarlos, cuáles caben en 8 GB de VRAM y qué clips salen de mi equipo.
      </p>
    </div>

    <Section eyebrow="Aviso honesto" title="Imposible generar vídeo de calidad">
      <p>
        Generar vídeo de calidad es imposible con 8 GB de VRAM. Los modelos
        capaces de clips largos, con resolución y coherencia decentes, piden
        mucha más memoria de la que hay en este equipo.
      </p>
      <p>
        Lo que sí sale: clips muy cortos, a resolución baja, como prueba o
        borrador. Lentos y con artefactos, pero sirven para experimentar y
        entender cómo funciona la generación de vídeo en local.
      </p>
      <p>
        Esta página recoge ese escenario real: con qué intentarlo y qué sale
        de verdad, sin prometer lo que el hardware no da.
      </p>
    </Section>

    <Section eyebrow="Programas" title="Software para generar vídeo en local">
      <SoftwareList items={videoSoftware} />
    </Section>

    <Section eyebrow="Para 8 GB de VRAM" title="Modelos recomendados para mis specs">
      <p>
        <span class="todo-flag">TODO: sustituir por datos reales</span>
      </p>
      <ModelList items={videoModels} />
    </Section>

    <Section eyebrow="Clips" title="Resultados conseguidos">
      <VideoResults items={videoResults} />
    </Section>
  </main>
  <Footer />
</Layout>

<style>
  .page-head {
    padding-block: var(--space-4xl) var(--space-2xl);
  }

  .page-head h1 {
    margin: 0 0 var(--space-lg);
  }

  .lead {
    font-size: 1.125rem;
    margin: 0;
  }
</style>
