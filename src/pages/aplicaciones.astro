---
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import Info from "@/components/Info.astro";
import PinokioTable from "@/components/PinokioTable.astro";
import Section from "@/components/Section.astro";
import SoftwareList from "@/components/SoftwareList.astro";
import { appSoftware, pinokioApps } from "@/data/software";
import Layout from "@/layouts/Layout.astro";
---

<Layout
  title="Aplicaciones"
  description="Apps que usan IA en local sin tocar modelos: instalas, abres y funciona."
>
  <Header />
  <main id="main">
    <div class="container page-head">
      <p class="eyebrow">Usar sin configurar</p>
      <h1>Aplicaciones</h1>
      <p class="lead">
        Programas que te ayudan a no pelearte con configuraciones y
        dependencias.
      </p>
    </div>

    <Section eyebrow="Motores vs aplicaciones" title="Apps que usan IA">
      <SoftwareList items={appSoftware} />
    </Section>

    <Section eyebrow="Dentro de Pinokio" title="Apps recomendadas en Pinokio">
      <PinokioTable items={pinokioApps} />
    </Section>
  </main>
  <Footer />
</Layout>

<style>
  .page-head {
    padding-block: var(--space-4xl) var(--space-2xl);
  }

  .page-head h1 {
    margin: 0 0 var(--space-lg);
  }

  .lead {
    font-size: 1.125rem;
    margin: 0;
  }
</style>
