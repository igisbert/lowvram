---
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import Info from "@/components/Info.astro";
import ModelTable from "@/components/ModelTable.astro";
import ResultShowcase from "@/components/ResultShowcase.astro";
import Section from "@/components/Section.astro";
import SoftwareList from "@/components/SoftwareList.astro";
import Spotlight from "@/components/Spotlight.astro";
import SubNav from "@/components/SubNav.astro";
import {
  bgResults,
  diffusionResults,
  upscaleResults,
} from "@/data/image-results";
import {
  bgModels,
  diffusionModels,
  upscaleModels,
} from "@/data/models";
import {
  bgSoftware,
  diffusionSoftware,
  upscaleSoftware,
} from "@/data/software";
import { diffusionSpotlights } from "@/data/spotlights";
import Layout from "@/layouts/Layout.astro";

const anchors = [
  { label: "Difusión", href: "#difusion" },
  { label: "Upscale", href: "#upscale" },
  { label: "Borrado de fondo", href: "#fondo" },
];
---

<Layout
  title="Modelos de imagen"
  description="Difusión, upscale y otros modelos de imagen ejecutados en local en una RTX 2070 con 8 GB de VRAM, con resultados comparables."
>
  <Header />
  <main id="main">
    <div class="container page-head">
      <p class="eyebrow">Difusión, upscale y segmentación</p>
      <h1>Modelos de imagen</h1>
      <p class="lead">
        Generar desde cero, ampliar y eliminar fondos. Cada uno con su software,
        sus modelos y sus resultados.
      </p>
      <SubNav items={anchors} />
    </div>

    <Section
      eyebrow="Texto a imagen, edición, img2img, inpainting con máscara..."
      title="Difusión"
      id="difusion"
    >
      <h3 class="group">Software</h3>
      <SoftwareList items={diffusionSoftware} />
      <h3 class="group">Complementos</h3>
      <Spotlight items={diffusionSpotlights} />
      <h3 class="group">Modelos que he probado</h3>
      <Info title="¿Qué son los Turbo?">
        <p>
          Versiones destiladas que necesitan pocos pasos. Son mucho más rápidas
          a cambio de tener menor creatividad. Más repetitivos y responden peor
          a las ideas raras.
        </p>
      </Info>
      <ModelTable items={diffusionModels} />
      <div class="lora-note">
        <Info title="Modificar comportamiento del modelo">
          <p>
            Una LoRA es un parche pequeño que modifica un modelo sin
            reentrenarlo. Puede darle un estilo o una capacidad que no tiene, o
            acelerarlo para que funcione en pocos pasos (por ejemplo, una LoRA
            megaturbo).
          </p>
        </Info>
      </div>
      <h3 class="group" id="resultados-difusion">Resultados conseguidos</h3>
      <ResultShowcase sets={diffusionResults} scrollTarget="resultados-difusion" />
    </Section>

    <Section eyebrow="Ampliar sin inventar" title="Upscale" id="upscale">
      <h3 class="group">Software</h3>
      <SoftwareList items={upscaleSoftware} />
      <h3 class="group">Modelos que he probado</h3>

      <ModelTable items={upscaleModels} />
      <h3 class="group" id="resultados-upscale">Resultados conseguidos</h3>
      <ResultShowcase sets={upscaleResults} scrollTarget="resultados-upscale" />
    </Section>

    <Section eyebrow="Retoques útiles" title="Borrado de fondo" id="fondo">
      <h3 class="group">Software</h3>
      <SoftwareList items={bgSoftware} />
      <h3 class="group">Modelos que he probado</h3>
      <ModelTable items={bgModels} />
      <h3 class="group" id="resultados-fondo">Resultados conseguidos</h3>
      <ResultShowcase sets={bgResults} scrollTarget="resultados-fondo" />
    </Section>
  </main>
  <Footer />
</Layout>

<style>
  .page-head {
    padding-block: var(--space-4xl) var(--space-2xl);
  }

  .page-head h1 {
    margin: 0 0 var(--space-lg);
  }

  .lead {
    font-size: 1.125rem;
    margin: 0 0 var(--space-xl);
  }

  .group {
    margin: var(--space-2xl) 0 var(--space-lg);
  }

  .group:first-of-type {
    margin-top: 0;
  }

  .group[id] {
    scroll-margin-top: 80px;
  }

  .lora-note {
    margin-top: var(--space-lg);
  }
</style>
