---
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import Info from "@/components/Info.astro";
import InvoiceDemo from "@/components/InvoiceDemo.astro";
import CalculadoraLing from "@/components/llm/ling-3.0-tiny-q5_k_m/calculadora.astro";
import CalculadoraQwen from "@/components/llm/qwen3.6-35b-a3b-iq2_xxs/Calculadora.astro";
import MusicPlayerQwen from "@/components/llm/qwen3.6-35b-a3b-iq2_xxs/MusicPlayer.astro";
import Test from "@/components/llm/qwen3.6-35b-a3b-iq2_xxs/test.astro";
import LandingQwen from "@/components/llm/qwen3.6-35b-a3b-iq2_xxs/Landing.astro";
import FAQLing from "@/components/llm/ling-3.0-tiny-q5_k_m/FAQ.astro";
import LandingLing from "@/components/llm/ling-3.0-tiny-q5_k_m/Landing.astro";
import LandingMimo from "@/components/llm/mimo-v2.6-distill-qwen-9b-q4_k_s/Landing.astro";
import WritingLfm from "@/components/llm/lfm2.5-24b-a2b-q3_k_xl/Writing.astro";
import WritingLing from "@/components/llm/ling-3.0-tiny-q5_k_m/Writing.astro";
import WritingMiMo from "@/components/llm/mimo-v2.6-distill-qwen-9b-q4_k_s/Writing.astro";
import WritingNemotron from "@/components/llm/nvidia-nemotron-3.5-bolt-e4b-q4_k_xl/Writing.astro";
import WritingQwen from "@/components/llm/qwen3.6-35b-a3b-iq2_xxs/Writing.astro";
import CalculadoraLfm from "@/components/llm/lfm2.5-24b-a2b-q3_k_xl/Calculadora.astro";
import MusicPlayerLfm from "@/components/llm/lfm2.5-24b-a2b-q3_k_xl/MusicPlayer.astro";
import FAQMimo from "@/components/llm/mimo-v2.6-distill-qwen-9b-q4_k_s/FAQ.astro";
import FAQQwen from "@/components/llm/qwen3.6-35b-a3b-iq2_xxs/FAQ.astro";
import MusicPlayerLing from "@/components/llm/ling-3.0-tiny-q5_k_m/MusicPlayer.astro";
import SnakeNemotron from "@/components/llm/nvidia-nemotron-3.5-bolt-e4b-q4_k_xl/Snake.astro";
import SnakeGame from "@/components/llm/qwen3.6-35b-a3b-iq2_xxs/SnakeGame.astro";
import CalculadoraNemotron from "@/components/llm/nvidia-nemotron-3.5-bolt-e4b-q4_k_xl/Calculadora.astro";
import MusicPlayerNemotron from "@/components/llm/nvidia-nemotron-3.5-bolt-e4b-q4_k_xl/MusicPlayer.astro";
import FAQNemotron from "@/components/llm/nvidia-nemotron-3.5-bolt-e4b-q4_k_xl/FAQ.astro";
import LandingNemotron from "@/components/llm/nvidia-nemotron-3.5-bolt-e4b-q4_k_xl/Landing.astro";
import Trial from "@/components/Trial.astro";
import TrialGroup from "@/components/TrialGroup.astro";
import TextBox from "@/components/TextBox.astro";
import Verdict from "@/components/Verdict.astro";
import ModelTable from "@/components/ModelTable.astro";
import Section from "@/components/Section.astro";
import SoftwareList from "@/components/SoftwareList.astro";
import { llmModels } from "@/data/models";
import { llmAgents, llmSoftware } from "@/data/software";
import { verdicts } from "@/data/verdicts";
import invoiceLfm from "@/data/invoices/lfm2.5-24b-a2b.json?raw";
import invoiceLing from "@/data/invoices/ling-3.0-tiny.json?raw";
import invoiceMiMo from "@/data/invoices/mimo-v2.6-distill-qwen-9b.json";
import invoiceNemotron from "@/data/invoices/nvidia-nemotron-3.5-bolt-e4b.json?raw";
import invoiceQwen from "@/data/invoices/qwen3.6-35b-a3b.json?raw";
import invoicePrompt from "@/data/invoices/prompt.txt?raw";
import Layout from "@/layouts/Layout.astro";

const invoiceMiMoJson = JSON.stringify(invoiceMiMo, null, 2);
---

<Layout
  title="Modelos de texto"
  description="Software, modelos recomendados y resultados medidos de LLM ejecutados en local en una RTX 2070 con 8 GB de VRAM."
>
  <Header />
  <main id="main">
    <div class="container page-head">
      <p class="eyebrow">LLM locales</p>
      <h1>Modelos de texto</h1>
      <p class="lead">
        Con qué ejecutarlos, cuáles caben en 8 GB de VRAM y a qué velocidad van
        medidos en mi equipo.
      </p>
    </div>

    <Section
      eyebrow="Motores de inferencia y aplicaciones"
      title="Software para usar LLM locales"
    >
      <SoftwareList items={llmSoftware} />
    </Section>

    <Section eyebrow="Donde se utiliza el modelo" title="Agentes y servidor">
      <SoftwareList items={llmAgents} />
    </Section>

    <Section
      eyebrow="Para 8 GB de VRAM y 16 GB de RAM"
      title="Modelos que he probado"
    >
      <Info title="Ojo con la visión">
        <p>
          Para que un modelo pueda usar sus capacidades de ver imágenes, hay que
          cargar además su proyector multimodal (mmproj) correspondiente.
        </p>
      </Info>
      <ModelTable items={llmModels} />
    </Section>

    <Section eyebrow="En acción" title="Pruebas">
      <TextBox title="Cómo se han hecho las pruebas">
        <p>
          Cada prueba se generó entre 3 y 5 veces usándose en un solo prompt y
          se eligió la que mejor funcionaba. Solo se han renombrado clases y
          eliminado IDs para evitar colisiones, algo que no es culpa de los
          modelos ni cambia el comportamiento del artefacto.
        </p>
      </TextBox>
      <Trial
        title="TEST"
        model="Qwen3.6-35B"
        runner="Pi"
        tokens="21.683 tokens"
        duration="8 min 40 s"
        speed="30 t/s"
      >
        <Test />
      </Trial>

      <h3 class="group">Artefactos</h3>
      <TrialGroup title="Calculadora" count={4}>
        <Trial
          model="NVIDIA-Nemotron-3.5-Bolt-E4B"
          fullModel="NVIDIA-Nemotron-3.5-Bolt-E4B-UD-Q4_K_XL.gguf"
          runner="Pi"
          tokens="4.234 tokens"
          duration="1 min 1 s"
          speed="63 t/s"
        >
          <CalculadoraNemotron />
        </Trial>
        <Trial
          model="Ling 3.0 Tiny"
          fullModel="Ling 3.0 Tiny Q5_K_M.gguf"
          runner="llama-server"
          tokens="24.503 tokens"
          duration="3 min 58 s"
          speed="102,79 t/s"
        >
          <CalculadoraLing />
        </Trial>
        <Trial
          model="Qwen3.6-35B"
          runner="Pi"
          tokens="21.683 tokens"
          duration="8 min 40 s"
          speed="30 t/s"
        >
          <CalculadoraQwen />
        </Trial>
        <Trial
          model="LFM2.5-24B-A2B"
          fullModel="LFM2.5-24B-A2B-UD-Q3_K_XL.gguf"
          runner="llama-server"
          tokens="7.651 tokens"
          duration="4 min 35 s"
          speed="27,77 t/s"
        >
          <CalculadoraLfm />
        </Trial>
      </TrialGroup>
      <TrialGroup title="MusicPlayer" count={4}>
        <Trial
          model="NVIDIA-Nemotron-3.5-Bolt-E4B"
          fullModel="NVIDIA-Nemotron-3.5-Bolt-E4B-UD-Q4_K_XL.gguf"
          runner="llama-server"
          tokens="4.163 tokens"
          duration="1 min 10 s"
          speed="60 t/s"
        >
          <MusicPlayerNemotron />
        </Trial>
        <Trial
          model="Ling 3.0 Tiny"
          fullModel="Ling 3.0 Tiny Q5_K_M.gguf"
          runner="OpenCode"
          tokens="27.795 tokens"
          duration="3 min 47 s"
          speed="103 t/s"
        >
          <MusicPlayerLing />
        </Trial>
        <Trial
          runner="llama-server"
          model="Qwen3.6-35B"
          tokens="5461 tokens"
          duration="2 min 30 s"
          speed="36,18 t/s"
        >
          <MusicPlayerQwen />
        </Trial>
        <Trial
          model="LFM2.5-24B-A2B"
          fullModel="LFM2.5-24B-A2B-UD-Q3_K_XL.gguf"
          runner="llama-server"
          tokens="6.165 tokens"
          duration="3 min 30 s"
          speed="29,30 t/s"
        >
          <MusicPlayerLfm />
        </Trial>
      </TrialGroup>
      <TrialGroup title="FAQ" count={4}>
        <Trial
          model="NVIDIA-Nemotron-3.5-Bolt-E4B"
          fullModel="NVIDIA-Nemotron-3.5-Bolt-E4B-UD-Q4_K_XL.gguf"
          runner="Pi"
          tokens="2.829 tokens"
          duration="41 s"
          speed="63 t/s"
        >
          <FAQNemotron />
        </Trial>
        <Trial
          model="MiMo-V2.6-Distill-Qwen-9B"
          runner="Pi"
          tokens="42.143 tokens"
          duration="9 min 21 s"
          speed="42 t/s"
        >
          <FAQMimo />
        </Trial>
        <Trial
          model="Ling 3.0 Tiny"
          fullModel="Ling 3.0 Tiny Q5_K_M.gguf"
          runner="llama-server"
          tokens="22.459 tokens"
          duration="3 min 25 s"
          speed="109,52 t/s"
        >
          <FAQLing />
        </Trial>
        <Trial
          runner="Pi"
          model="Qwen3.6-35B"
          tokens="3.036 tokens"
          duration="1 min 17 s"
          speed="37,11 t/s"
        >
          <FAQQwen />
        </Trial>
      </TrialGroup>
      <TrialGroup title="Landing Page" count={4}>
        <Trial
          model="NVIDIA-Nemotron-3.5-Bolt-E4B"
          fullModel="NVIDIA-Nemotron-3.5-Bolt-E4B-UD-Q4_K_XL.gguf"
          runner="llama-server"
          tokens="3.794 tokens"
          duration="1 min 5 s"
          speed="58 t/s"
        >
          <LandingNemotron />
        </Trial>
        <Trial
          model="MiMo-V2.6-Distill-Qwen-9B"
          runner="llama-server"
          tokens="15.468 tokens"
          duration="5 min 56 s"
          speed="45 t/s"
        >
          <LandingMimo />
        </Trial>
        <Trial
          runner="Pi"
          model="Ling 3.0 Tiny"
          tokens="25.684 tokens"
          duration="4 min 6 s"
          speed="104 t/s"
        >
          <LandingLing />
        </Trial>
        <Trial
          runner="Pi"
          model="Qwen3.6-35B"
          tokens="6.736 tokens"
          duration="2 min 49 s"
          speed="38 t/s"
        >
          <LandingQwen />
        </Trial>
      </TrialGroup>
      <TrialGroup title="Snake" count={2}>
        <Trial
          model="NVIDIA-Nemotron-3.5-Bolt-E4B"
          fullModel="NVIDIA-Nemotron-3.5-Bolt-E4B-UD-Q4_K_XL.gguf"
          runner="Pi"
          tokens="4.300 tokens"
          duration="1 min 11 s"
          speed="61 t/s"
        >
          <SnakeNemotron />
        </Trial>
        <Trial
          model="Qwen3.6-35B"
          runner="Pi"
          tokens="16.320 tokens"
          duration="6 min 15 s"
          speed="32 t/s"
        >
          <SnakeGame />
        </Trial>
      </TrialGroup>

      <h3 class="group">Texto y datos</h3>
      <TrialGroup title="Correo: corrección, formal y resumen" count={5}>
        <Trial
          model="NVIDIA-Nemotron-3.5-Bolt-E4B"
          fullModel="NVIDIA-Nemotron-3.5-Bolt-E4B-UD-Q4_K_XL.gguf"
          runner="llama-server"
          tokens="1.893 tokens"
          duration="29 s"
          speed="63,28 t/s"
        >
          <WritingNemotron />
        </Trial>
        <Trial
          model="MiMo-V2.6-Distill-Qwen-9B"
          runner="Pi"
          tokens="1.304 tokens"
          duration="27 s"
          speed="49 t/s"
        >
          <WritingMiMo />
        </Trial>
        <Trial
          model="Ling 3.0 Tiny"
          fullModel="Ling 3.0 Tiny Q5_K_M.gguf"
          runner="Pi"
          tokens="7.804 tokens"
          duration="1 min 9 s"
          speed="113 t/s"
        >
          <WritingLing />
        </Trial>
        <Trial
          model="Qwen3.6-35B"
          runner="Pi"
          tokens="4.367 tokens"
          duration="1 min 7 s"
          speed="33 t/s"
        >
          <WritingQwen />
        </Trial>
        <Trial
          model="LFM2.5-24B-A2B"
          fullModel="LFM2.5-24B-A2B-UD-Q3_K_XL.gguf"
          runner="Pi"
          tokens="5.508 tokens"
          duration="2 min 2 s"
          speed="42 t/s"
        >
          <WritingLfm />
        </Trial>
      </TrialGroup>
      <TrialGroup title="Factura a JSON" count={5}>
        <Trial
          model="NVIDIA-Nemotron-3.5-Bolt-E4B"
          fullModel="NVIDIA-Nemotron-3.5-Bolt-E4B-UD-Q4_K_XL.gguf"
          runner="llama-server"
          tokens="1.042 tokens"
          duration="15 s"
          speed="65,28 t/s"
        >
          <InvoiceDemo
            pdf="/invoices/invoice.pdf"
            pdfName="invoice.pdf"
            prompt={invoicePrompt.trim()}
            output={invoiceNemotron.trim()}
          />
        </Trial>
        <Trial
          model="MiMo-V2.6-Distill-Qwen-9B"
          runner="llama-server"
          tokens="526 tokens"
          duration="10 s"
          speed="48,09 t/s"
        >
          <InvoiceDemo
            pdf="/invoices/invoice.pdf"
            pdfName="invoice.pdf"
            prompt={invoicePrompt.trim()}
            output={invoiceMiMoJson}
          />
        </Trial>
        <Trial
          model="Ling 3.0 Tiny"
          fullModel="Ling 3.0 Tiny Q5_K_M.gguf"
          runner="llama-server"
          tokens="618 tokens"
          duration="6,0 s"
          speed="103,58 t/s"
        >
          <InvoiceDemo
            pdf="/invoices/invoice.pdf"
            pdfName="invoice.pdf"
            prompt={invoicePrompt.trim()}
            output={invoiceLing.trim()}
          />
        </Trial>
        <Trial
          model="Qwen3.6-35B"
          runner="llama-server"
          tokens="947 tokens"
          duration="24 s"
          speed="39,33 t/s"
        >
          <InvoiceDemo
            pdf="/invoices/invoice.pdf"
            pdfName="invoice.pdf"
            prompt={invoicePrompt.trim()}
            output={invoiceQwen.trim()}
          />
        </Trial>
        <Trial
          model="LFM2.5-24B-A2B"
          fullModel="LFM2.5-24B-A2B-UD-Q3_K_XL.gguf"
          runner="llama-server"
          tokens="600 tokens"
          duration="14 s"
          speed="40,93 t/s"
        >
          <InvoiceDemo
            pdf="/invoices/invoice.pdf"
            pdfName="invoice.pdf"
            prompt={invoicePrompt.trim()}
            output={invoiceLfm.trim()}
          />
        </Trial>
      </TrialGroup>
      <TextBox title="Sobre los artefactos interactivos">
        <p>
          Los artefactos interactivos se han aislado entre sí para que cada uno
          reciba sus propios eventos. El cambio es solo de integración: no toca
          la lógica, el diseño ni el resultado de los modelos. Si un artefacto
          falla, el fallo se queda visible porque forma parte de la prueba.
        </p>
      </TextBox>
    </Section>
    <Section eyebrow="Veredicto" title="Resultados conseguidos">
      <div class="verdicts">
        {verdicts.map((verdict) => <Verdict verdict={verdict} />)}
      </div>
      <TextBox title="Conclusión">
        <p>
          La forma de programar con LLM locales es diferente a la de los modelos
          cloud. No puedes lanzar una tarea gigante y esperar que el agente lo
          resuelva en un “one shot”. Tienes que dividir las tareas e ir ayudando
          al agente.
        </p>
        <p>
          Para procesar datos y escribir texto, en cambio, funcionan realmente
          bien. Puedes extraer información de documentos, redactar, reescribir o
          corregir textos, y revisar el resultado por partes.
        </p>
      </TextBox>
    </Section>
  </main>
  <Footer />
</Layout>

<style>
  .page-head {
    padding-block: var(--space-4xl) var(--space-2xl);
  }

  .page-head h1 {
    margin: 0 0 var(--space-lg);
  }

  .lead {
    font-size: 1.125rem;
    margin: 0;
  }

  .group {
    margin: var(--space-2xl) 0 var(--space-lg);
  }

  .verdicts {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
  }

  @media (min-width: 768px) {
    .verdicts {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
