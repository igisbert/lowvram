---
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import CalculadoraLing from "@/components/llm/ling-3.0-tiny-q5_k_m/calculadora.astro";
import FAQLing from "@/components/llm/ling-3.0-tiny-q5_k_m/FAQ.astro";
import FAQMimo from "@/components/llm/mimo-v2.6-distill-qwen-9b-q4_k_s/FAQ.astro";
import MusicPlayerLing from "@/components/llm/ling-3.0-tiny-q5_k_m/MusicPlayer.astro";
import Trial from "@/components/Trial.astro";
import ModelTable from "@/components/ModelTable.astro";
import ResultsTable from "@/components/ResultsTable.astro";
import Section from "@/components/Section.astro";
import SoftwareList from "@/components/SoftwareList.astro";
import { llmResults } from "@/data/llm-results";
import { llmModels } from "@/data/models";
import { llmAgents, llmSoftware } from "@/data/software";
import Layout from "@/layouts/Layout.astro";
---

<Layout
  title="Modelos de texto"
  description="Software, modelos recomendados y resultados medidos de LLM ejecutados en local en una RTX 2070 con 8 GB de VRAM."
>
  <Header />
  <main id="main">
    <div class="container page-head">
      <p class="eyebrow">Texto · LLM locales</p>
      <h1>Modelos de texto</h1>
      <p class="lead">
        Con qué ejecutarlos, cuáles caben en 8 GB de VRAM y a qué velocidad van
        medidos en mi equipo.
      </p>
    </div>

    <Section eyebrow="Programas" title="Software para usar LLM locales">
      <SoftwareList items={llmSoftware} />
    </Section>

    <Section eyebrow="Herramientas" title="Agentes">
      <SoftwareList items={llmAgents} />
    </Section>

    <Section eyebrow="Para 8 GB de VRAM y 16 GB de RAM" title="Modelos que he probado">
      <ModelTable items={llmModels} />
    </Section>

    <Section eyebrow="Mediciones" title="Resultados conseguidos">
      <ResultsTable rows={llmResults} />
    </Section>

    <Section eyebrow="En acción" title="Pruebas">

      <Trial
        title="Calculadora"
        model="Ling 3.0 Tiny"
        fullModel="Ling 3.0 Tiny Q5_K_M.gguf"
        runner="llama-server"
        tokens="24.503 tokens"
        duration="3min 58s"
        speed="102.79 t/s"
      >
        <CalculadoraLing />
      </Trial>
      <Trial
        title="MusicPlayer"
        model="Ling 3.0 Tiny"
        fullModel="Ling 3.0 Tiny Q5_K_M.gguf"
        runner="OpenCode"
        tokens="27.795 tokens"
        duration="3m 47s"
        speed="103 t/s"
      >
        <MusicPlayerLing />
      </Trial>
      <Trial
        title="FAQ"
        model="Ling 3.0 Tiny"
        fullModel="Ling 3.0 Tiny Q5_K_M.gguf"
        runner="llama-server"
        tokens="22.459 tokens"
        duration="3min 25s"
        speed="109.52 t/s"
      >
        <FAQLing />
      </Trial>
      <Trial
        title="FAQ"
        model="MiMo 2.6"
        runner="Pi"
        tokens="↑19k ↓23k tokens"
        duration="9m21s"
        speed="42 t/s"
      >
        <FAQMimo />
      </Trial>
    </Section>
  </main>
  <Footer />
</Layout>

<style>
  .page-head {
    padding-block: var(--space-4xl) var(--space-2xl);
  }

  .page-head h1 {
    margin: 0 0 var(--space-lg);
  }

  .lead {
    font-size: 1.125rem;
    margin: 0;
  }
</style>
