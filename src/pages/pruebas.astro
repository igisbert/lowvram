---
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import Section from "@/components/Section.astro";
import TextBox from "@/components/TextBox.astro";
import Layout from "@/layouts/Layout.astro";
import { prompts } from "@/data/prompts";
---

<Layout
  title="Las pruebas"
  description="Los prompts exactos con los que se han puesto a prueba los LLM locales en una RTX 2070 con 8 GB de VRAM."
  seoTitle="Pruebas a los LLM · IA local con 8 GB de VRAM"
>
  <Header />
  <main id="main">
    <div class="container page-head">
      <p class="eyebrow">Sin trampa ni cartón</p>
      <h1>Las pruebas</h1>
      <p class="lead">
        Los prompts exactos que se les pasaron a los modelos, sin filtros ni
        trucos, para que los resultados sean comparables.
      </p>
    </div>

    <Section eyebrow="Metodología" title="Qué se pone a prueba">
      <TextBox>
        <p>
          La batería cubre dos frentes. Cinco de las pruebas son de código, y
          piden construir algo que funciona dentro de una página real, con
          restricciones duras de aislamiento, accesibilidad y recursos externos.
          Las otras dos son de texto y de entendimiento, donde toca seguir
          instrucciones al detalle y devolver datos estructurados sin inventar
          nada.
        </p>
        <p>
          El prompt siempre es el mismo para todos los modelos, y está escrito
          en español, como el resto de la web. A continuación lo tienes íntegro,
          tal como se envió.
        </p>
      </TextBox>
    </Section>

    <Section eyebrow="Las pruebas" title="Los prompts, uno a uno">
      {
        prompts.map((prompt, index) => (
          <article class="prompt">
            <p class="mono kicker">
              Prompt {String(index + 1).padStart(2, "0")}
            </p>
            <h3>{prompt.name}</h3>
            <p class="focus">{prompt.focus}</p>
            <pre>{prompt.text}</pre>
          </article>
        ))
      }
    </Section>
  </main>
  <Footer />
</Layout>

<style>
  .page-head {
    padding-block: var(--space-4xl) var(--space-2xl);
  }

  .page-head h1 {
    margin: 0 0 var(--space-lg);
  }

  .lead {
    font-size: 1.125rem;
    margin: 0;
  }

  .prompt {
    max-width: var(--measure);
    margin-block: var(--space-lg);
    background: var(--canvas-card);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    padding: var(--space-xl);
  }

  .kicker {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 var(--space-sm);
  }

  .prompt h3 {
    margin: 0 0 var(--space-sm);
    font-size: 1.25rem;
  }

  .focus {
    margin: 0 0 var(--space-lg);
    color: var(--mute);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  pre {
    margin: 0;
    padding: var(--space-lg);
    background: var(--canvas-soft);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--body);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
</style>
