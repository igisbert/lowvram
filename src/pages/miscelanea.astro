---
import DecisionDemo from "@/components/DecisionDemo.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import ModelTable from "@/components/ModelTable.astro";
import OcrDemo from "@/components/OcrDemo.astro";
import TextBox from "@/components/TextBox.astro";
import Section from "@/components/Section.astro";
import SoftwareList from "@/components/SoftwareList.astro";
import SubNav from "@/components/SubNav.astro";
import Info from "@/components/Info.astro";
import { classifierModels, ocrModels } from "@/data/models";
import { classifierSoftware, ocrSoftware } from "@/data/software";
import cuchilloOutput from "@/data/ocr/un-carnivoro-cuchillo.txt?raw";
import emosidoOutput from "@/data/ocr/emosido.txt?raw";
import ticketOutput from "@/data/ocr/ticket.txt?raw";
import decisionInput from "@/data/decisions/input.json?raw";
import juliaOutput from "@/data/decisions/julia.json?raw";
import kevOutput from "@/data/decisions/kev.json?raw";
import layaOutput from "@/data/decisions/laya.json?raw";
import Layout from "@/layouts/Layout.astro";

const anchors = [
  { label: "OCR", href: "#ocr" },
  { label: "Clasificadores", href: "#clasificadores" },
];
---

<Layout
  title="Miscelánea"
  description="Modelos variados ejecutados en local: OCR, clasificadores y más, sin nube."
>
  <Header />
  <main id="main">
    <div class="container page-head">
      <p class="eyebrow">Funcionalidades variadas</p>
      <h1>Miscelánea</h1>
      <p class="lead">
        Categorías que no llenarían una página propia pero que tienen su
        utilidad.
      </p>
      <SubNav items={anchors} />
    </div>

    <Section eyebrow="Texto en imágenes y documentos" title="OCR" id="ocr">
      <h3 class="group">Software</h3>
      <SoftwareList items={ocrSoftware} />
      <h3 class="group">Modelos que he probado</h3>
      <Info title="Cuidado con los PDF">
        <p>
          Al adjuntar un fichero PDF para el OCR, llama-server lo convierte
          automáticamente a imagen para procesarlo. Si los PDF tienen más de una
          página, prácticamente todas los intentos me ha devuelto el contenido
          de una página o, en algunas ocasiones, se ha quedado en bucle
          infinito.
        </p>
      </Info>
      <ModelTable items={ocrModels} />
      <h3 class="group">Pruebas reales</h3>
      <OcrDemo
        image="/galleries/ocr/un-carnivoro-cuchillo.webp"
        imageAlt="Poema impreso con tipografía antigua sobre papel amarillento"
        output={cuchilloOutput.trim()}
        model="GLM-OCR"
        runner="llama-server"
        tokens="145 tokens"
        duration="1,0 s"
        speed="151,63 t/s"
      />
      <OcrDemo
        image="/galleries/ocr/emosido.webp"
        imageAlt="Pintada en una pared que dice EMOSIDO ENGAÑADO"
        output={emosidoOutput.trim()}
        model="GLM-OCR"
        runner="llama-server"
        tokens="12 tokens"
        duration="0,1 s"
        speed="156,24 t/s"
      />
      <OcrDemo
        image="/galleries/ocr/ticket.webp"
        imageAlt="Ticket de compra arrugado"
        output={ticketOutput.trim()}
        model="GLM-OCR"
        runner="llama-server"
        tokens="273 tokens"
        duration="1,8 s"
        speed="155,63 t/s"
      />
      <TextBox title="Conclusión">
        <p>
          Para fotos con texto legible, en general, todos cumplen. En fotos muy
          complicadas (texto en espiral, papeles arrugados, fuentes
          ininteligibles) fallan. Y en documentos de varias páginas funciona
          regular.
        </p>
      </TextBox>
    </Section>

    <Section
      eyebrow="Decidir sin generar"
      title="Clasificadores"
      id="clasificadores"
    >
      <h3 class="group">Software</h3>

      <SoftwareList items={classifierSoftware} />
      <h3 class="group">Modelos que he probado</h3>

      <ModelTable items={classifierModels} />
      <h3 class="group">Pruebas reales</h3>
      <DecisionDemo
        input={decisionInput.trim()}
        output={juliaOutput.trim()}
        model="Julia-1-BF16"
        runner="llama-server"
        duration="<1s"
        conclusion="Julia es el que más seguridad tiene en la opción correcta. Además, ha sido consistente al eleminar la palabra 'shot' del criterio 'three shot'. "
      />
      <DecisionDemo
        input={decisionInput.trim()}
        output={layaOutput.trim()}
        model="Laya-BF16"
        runner="llama-server"
        duration="<1s"
        conclusion="Laya, aunque acierta, no tiene la seguridad de Julia. Además, al eliminar la palabra 'shot' del criterio 'three shot', la probabilidad se desplomaba, subiendo mucho la probabilidad de las opciones que no son correctas. "
      />
      <DecisionDemo
        input={decisionInput.trim()}
        output={kevOutput.trim()}
        model="Kev-4B-Q4_K_M"
        runner="llama-server"
        duration="<1s"
        conclusion="Kev es el que menos seguridad tiene en la respuesta correcta. Al igual que Laya, al eliminar la palabra 'shot' del criterio fallaba más, prácticamente igualando las tres puntuaciones. "
      />
    </Section>
  </main>
  <Footer />
</Layout>

<style>
  .page-head {
    padding-block: var(--space-4xl) var(--space-2xl);
  }

  .page-head h1 {
    margin: 0 0 var(--space-lg);
  }

  .lead {
    font-size: 1.125rem;
    margin: 0 0 var(--space-xl);
  }

  .group {
    margin: var(--space-2xl) 0 var(--space-lg);
  }

  .group:first-of-type {
    margin-top: 0;
  }
</style>
